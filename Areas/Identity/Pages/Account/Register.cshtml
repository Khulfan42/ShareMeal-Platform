@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
    ViewData["BackgroundImage"] = "/auth_bg.png";
}

<div class="relative min-h-[90vh] flex items-center justify-center px-6 py-12 overflow-hidden">
     <!-- Overlay for better contrast -->
    <div class="absolute inset-x-0 bottom-0 top-0 z-0 bg-white/20 backdrop-blur-sm pointer-events-none"></div>

    <div class="w-full max-w-lg bg-white p-12 rounded-[3.5rem] shadow-2xl border border-slate-100 relative z-10">
        <div class="text-center mb-10">
            @{
                var returnUrlLowerReg = Model.ReturnUrl?.ToLower() ?? "";
                var regTitle = "Join ShareMeal";
                var regDesc = "Begin your <span class='text-emerald-600 font-bold'>Zero Waste</span> journey today.";
                
                if (returnUrlLowerReg.Contains("restaurant"))
                {
                    regTitle = "Restaurant Partner";
                    regDesc = "Start donating surplus food to those in need.";
                }
                else if (returnUrlLowerReg.Contains("charity"))
                {
                    regTitle = "NGO Network";
                    regDesc = "Register your organization to receive food alerts.";
                }
            }

            <div class="inline-flex items-center justify-center w-20 h-20 bg-slate-50 rounded-[2rem] mb-6 shadow-inner">
                <span class="text-4xl">🌱</span>
            </div>
            
            <h1 class="text-4xl font-black text-slate-900 mb-2 outfit">@regTitle</h1>
            <p class="text-slate-500 font-medium">@Html.Raw(regDesc)</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-bold bg-rose-50 p-4 rounded-2xl border border-rose-100 mb-6" role="alert"></div>

            <div class="space-y-5">
                <div class="group">
                    <label asp-for="Input.Email" class="block text-slate-400 text-[10px] font-black uppercase tracking-widest pl-4 mb-2"></label>
                    <input asp-for="Input.Email" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" autocomplete="username" aria-required="true" placeholder="organization@example.com" />
                    <span asp-validation-for="Input.Email" class="text-rose-500 text-[10px] font-bold pl-4 mt-1"></span>
                </div>

                <div class="group">
                    <label asp-for="Input.OrganizationName" class="block text-slate-400 text-[10px] font-black uppercase tracking-widest pl-4 mb-2">Organization Name</label>
                    <input asp-for="Input.OrganizationName" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" aria-required="true" placeholder="e.g. First Harvest" />
                    <span asp-validation-for="Input.OrganizationName" class="text-rose-500 text-[10px] font-bold pl-4 mt-1"></span>
                </div>

                <div class="group">
                    <label asp-for="Input.OrgType" class="block text-slate-400 text-[10px] font-black uppercase tracking-widest pl-4 mb-2">Type of Organization</label>
                    <div class="relative">
                        <select asp-for="Input.OrgType" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 focus:outline-none focus:border-emerald-500 font-bold transition-all appearance-none cursor-pointer">
                            <option value="Restaurant">Restaurant (Donor)</option>
                            <option value="Charity">Charity / NGO (Receiver)</option>
                        </select>
                        <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                             <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="group relative">
                    <label asp-for="Input.Password" class="block text-slate-400 text-[10px] font-black uppercase tracking-widest pl-4 mb-2"></label>
                    <div class="relative">
                        <input asp-for="Input.Password" id="passwordInput" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <button type="button" onclick="togglePassword('passwordInput', 'eyeIcon')" class="absolute right-5 top-1/2 -translate-y-1/2 p-2 hover:bg-slate-200 rounded-xl transition-colors">
                            <svg id="eyeIcon" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-rose-500 text-[10px] font-bold pl-4 mt-1"></span>
                </div>
                <div class="group relative">
                    <label asp-for="Input.ConfirmPassword" class="block text-slate-400 text-[10px] font-black uppercase tracking-widest pl-4 mb-2"></label>
                    <div class="relative">
                        <input asp-for="Input.ConfirmPassword" id="confirmPasswordInput" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <button type="button" onclick="togglePassword('confirmPasswordInput', 'eyeIconConfirm')" class="absolute right-5 top-1/2 -translate-y-1/2 p-2 hover:bg-slate-200 rounded-xl transition-colors">
                            <svg id="eyeIconConfirm" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-rose-500 text-[10px] font-bold pl-4 mt-1"></span>
                </div>
            </div>

            <button id="registerSubmit" type="submit" class="w-full bg-slate-900 hover:bg-emerald-600 text-white font-black py-5 rounded-2xl shadow-xl transition-all transform hover:scale-[1.02] active:scale-95 text-lg mt-4">
                Register Organization →
            </button>

            <div class="pt-6 text-center">
                <p class="text-slate-400 text-sm font-medium">
                    Already an authorized partner? 
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-emerald-600 hover:text-emerald-700 font-black ml-1 border-b-2 border-emerald-100 hover:border-emerald-600 transition-all">Sign In</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7 1.274-4.057 5.064-7 9.542-7 1.225 0 2.39.215 3.475.606m4.256 4.256c.553.791.996 1.666 1.311 2.6c-1.274 4.057-5.064 7-9.542 7-1.012 0-1.986-.15-2.902-.428M15 15l1.5 1.5M10.125 10.125L8.5 8.5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1l22 22" />';
            } else {
                input.type = "password";
                icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
            }
        }
    </script>
}
