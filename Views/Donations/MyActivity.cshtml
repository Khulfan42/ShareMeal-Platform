@model IEnumerable<ShareMeal.Web.Models.Donation>

@{
    ViewData["Title"] = "My Activity";
}

<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-10">
        <h1 class="text-4xl font-black text-white mb-2">My Activity</h1>
        <p class="text-slate-400">Track and manage your listings and claims.</p>
    </div>

    <div class="bg-slate-800/40 backdrop-blur-md rounded-3xl border border-slate-700/50 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-900/50 text-slate-400 text-xs uppercase tracking-widest font-bold">
                        <th class="px-8 py-5 border-b border-slate-700/50">Food Item</th>
                        <th class="px-8 py-5 border-b border-slate-700/50">Category</th>
                        <th class="px-8 py-5 border-b border-slate-700/50">Status</th>
                        <th class="px-8 py-5 border-b border-slate-700/50">Date</th>
                        <th class="px-8 py-5 border-b border-slate-700/50 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/30">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-700/20 transition-colors group">
                            <td class="px-8 py-6">
                                <p class="text-slate-100 font-bold">@item.FoodItem</p>
                                <p class="text-slate-500 text-xs">Qty: @item.Quantity</p>
                            </td>
                            <td class="px-8 py-6">
                                <span class="px-3 py-1 rounded-full bg-slate-900 text-slate-300 text-xs border border-slate-700">
                                    @item.Category
                                </span>
                            </td>
                            <td class="px-8 py-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium 
                                    @(item.Status == ShareMeal.Web.Models.DonationStatus.Available ? "bg-emerald-400/10 text-emerald-400" : 
                                      item.Status == ShareMeal.Web.Models.DonationStatus.Claimed ? "bg-amber-400/10 text-amber-400" : 
                                      "bg-blue-400/10 text-blue-400") uppercase">
                                    @item.Status
                                </span>
                            </td>
                            <td class="px-8 py-6 text-slate-400 text-sm">
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-8 py-6 text-right space-x-3">
                                @if (item.Status == ShareMeal.Web.Models.DonationStatus.Claimed)
                                {
                                    <form asp-action="MarkAsCollected" asp-route-id="@item.Id" method="post" class="inline">
                                        <button type="submit" class="text-xs font-bold text-emerald-400 hover:text-emerald-300">Mark Collected</button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-xs font-bold text-slate-400 hover:text-white">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20 bg-slate-900/20 rounded-3xl mt-8">
            <p class="text-slate-500 italic">No historical activity found.</p>
        </div>
    }
</div>
