@model ShareMeal.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<!-- Immersive Cinematic Food Background -->
<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
    <img src="/carousel_1.png" class="w-full h-full object-cover filter brightness-[0.45] contrast-[1.15] scale-105" alt="ShareMeal Food Rescue" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#020611]/90 via-[#020611]/75 to-[#020611]/95"></div>
</div>

<div class="min-h-[92vh] flex items-center justify-center px-4 py-16 relative z-10">
    <!-- Ambient Glow Orb -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/15 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-900/85 backdrop-blur-2xl p-8 sm:p-10 rounded-[36px] border border-white/10 shadow-[0_25px_70px_rgba(0,0,0,0.8)] relative z-10 transition-all duration-500 hover:border-emerald-500/30 hover:shadow-emerald-500/10">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white mb-4 shadow-lg shadow-emerald-500/30">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-white outfit tracking-tight mb-2">Welcome Back</h1>
            <p class="text-slate-400 text-sm font-medium">Log in to your <span class="text-emerald-400 font-bold">ShareMeal</span> account</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-rose-400 text-sm italic bg-rose-400/10 p-3 rounded-xl border border-rose-400/20 mb-4" role="alert"></div>

            <div class="space-y-1.5">
                <label asp-for="Email" class="block text-slate-300 text-[10px] font-black uppercase tracking-widest pl-2"></label>
                <input asp-for="Email" class="w-full bg-slate-950/60 border border-slate-700/80 rounded-2xl px-5 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-rose-400 text-xs italic pl-2"></span>
            </div>

            <div class="space-y-1.5 relative">
                <label asp-for="Password" class="block text-slate-300 text-[10px] font-black uppercase tracking-widest pl-2"></label>
                <div class="relative">
                    <input asp-for="Password" id="passwordInput" class="w-full bg-slate-950/60 border border-slate-700/80 rounded-2xl px-5 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all" placeholder="••••••••" />
                    <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 p-2 hover:bg-slate-800 rounded-xl transition-colors">
                        <svg id="eyeIcon" class="h-5 w-5 text-slate-400 hover:text-slate-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-rose-400 text-xs italic pl-2"></span>
            </div>

            <div class="flex items-center justify-between px-2 pt-1">
                <label class="flex items-center text-slate-300 text-xs cursor-pointer group select-none">
                    <input class="form-checkbox h-4 w-4 text-emerald-500 bg-slate-950 border-slate-700 rounded transition duration-150 ease-in-out mr-2.5" asp-for="RememberMe" />
                    <span class="group-hover:text-white transition-colors">Remember me</span>
                </label>
                <a href="#" class="text-emerald-400 hover:text-emerald-300 text-xs font-bold transition-colors">Forgot Password?</a>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 via-emerald-600 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-black py-4 rounded-2xl shadow-xl shadow-emerald-600/30 transition-all transform hover:scale-[1.02] active:scale-95 text-base flex items-center justify-center gap-2">
                <span>Log in Now</span>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </button>

            <!-- Divider -->
            <div class="relative my-5">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-800"></div></div>
                <div class="relative flex justify-center text-[10px] uppercase font-bold tracking-widest"><span class="bg-slate-900 px-3 text-slate-400">Or continue with</span></div>
            </div>

            <!-- Social Login Buttons -->
            <div class="grid grid-cols-2 gap-3">
                <button type="submit" formmethod="post" asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="flex items-center justify-center gap-2.5 bg-slate-950/70 hover:bg-slate-800 text-slate-200 border border-slate-700/80 rounded-2xl py-3 px-3 font-bold text-xs transition-all hover:scale-[1.02] active:scale-95 shadow-md">
                    <svg class="w-4 h-4" viewBox="0 0 24 24">
                        <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.4 8.8 5 12 5z"/>
                        <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
                        <path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.6 7.2C.6 9.2 0 11.5 0 14s.6 4.8 1.6 6.8l3.7-2.9c-.3-.7-.6-1.5-.6-2.3z"/>
                        <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.2 0-5.8-2.4-6.7-5.3L1.6 16C3.5 19.8 7.4 23 12 23z"/>
                    </svg>
                    <span>Google</span>
                </button>
                <button type="submit" formmethod="post" asp-action="ExternalLogin" asp-route-provider="Facebook" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="flex items-center justify-center gap-2.5 bg-slate-950/70 hover:bg-slate-800 text-slate-200 border border-slate-700/80 rounded-2xl py-3 px-3 font-bold text-xs transition-all hover:scale-[1.02] active:scale-95 shadow-md">
                    <svg class="w-4 h-4 fill-[#1877F2]" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    <span>Facebook</span>
                </button>
            </div>

            <p class="text-center text-slate-400 text-xs mt-6">
                Don't have an account? 
                <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-emerald-400 hover:text-emerald-300 font-black ml-1 transition-all underline decoration-emerald-500/40">Create One Free</a>
            </p>
        </form>
    </div>
</div>

<script>
    function togglePassword() {
        var input = document.getElementById("passwordInput");
        var icon = document.getElementById("eyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7 1.274-4.057 5.064-7 9.542-7 1.225 0 2.39.215 3.475.606m4.256 4.256c.553.791.996 1.666 1.311 2.6c-1.274 4.057-5.064 7-9.542 7-1.012 0-1.986-.15-2.902-.428M15 15l1.5 1.5M10.125 10.125L8.5 8.5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1l22 22" />';
        } else {
            input.type = "password";
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
        }
    }
</script>
