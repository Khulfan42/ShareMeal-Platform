@model ShareMeal.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="min-h-[90vh] bg-[#0f172a] flex items-center justify-center px-4 py-12">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
        <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#10b981] to-[#06b6d4] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
    </div>

    <div class="w-full max-w-lg bg-slate-900/40 backdrop-blur-xl p-10 rounded-[40px] border border-slate-700/50 shadow-2xl relative z-10 transition-all duration-500 hover:shadow-emerald-500/10">
        <div class="text-center mb-10">
            <h1 class="text-4xl font-black text-white mb-3 tracking-tighter">Join ShareMeal</h1>
            <p class="text-slate-400 font-medium tracking-tight">Be part of the <span class="text-emerald-400 font-bold">Zero Waste</span> movement</p>
        </div>

        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-rose-400 text-sm italic bg-rose-400/10 p-3 rounded-xl border border-rose-400/20 mb-6" role="alert"></div>

            <div class="space-y-2">
                <label asp-for="Email" class="block text-slate-400 text-xs font-bold uppercase tracking-widest pl-2"></label>
                <input asp-for="Email" class="w-full bg-slate-800/50 border border-slate-700 rounded-2xl px-6 py-4 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-all" placeholder="organization@example.com" />
                <span asp-validation-for="Email" class="text-rose-400 text-xs italic pl-2"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label asp-for="Password" class="block text-slate-400 text-xs font-bold uppercase tracking-widest pl-2"></label>
                    <input asp-for="Password" class="w-full bg-slate-800/50 border border-slate-700 rounded-2xl px-6 py-4 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-all" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-rose-400 text-xs italic pl-2"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="ConfirmPassword" class="block text-slate-400 text-xs font-bold uppercase tracking-widest pl-2"></label>
                    <input asp-for="ConfirmPassword" class="w-full bg-slate-800/50 border border-slate-700 rounded-2xl px-6 py-4 text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-all" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-rose-400 text-xs italic pl-2"></span>
                </div>
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black py-4 rounded-2xl shadow-xl shadow-emerald-900/30 transition-all transform hover:scale-[1.02] active:scale-95 text-lg">
                Create Organization Account
            </button>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-700/60"></div></div>
                <div class="relative flex justify-center text-xs uppercase"><span class="bg-slate-900/90 px-3 text-slate-400 font-semibold tracking-wider">Or register with</span></div>
            </div>

            <!-- Social Login Buttons -->
            <div class="grid grid-cols-2 gap-4">
                <button type="submit" formmethod="post" asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="flex items-center justify-center gap-3 bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 rounded-2xl py-3 px-4 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-95 shadow-md">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.4 8.8 5 12 5z"/>
                        <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
                        <path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.6 7.2C.6 9.2 0 11.5 0 14s.6 4.8 1.6 6.8l3.7-2.9c-.3-.7-.6-1.5-.6-2.3z"/>
                        <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.2 0-5.8-2.4-6.7-5.3L1.6 16C3.5 19.8 7.4 23 12 23z"/>
                    </svg>
                    Google
                </button>
                <button type="submit" formmethod="post" asp-action="ExternalLogin" asp-route-provider="Facebook" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="flex items-center justify-center gap-3 bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700/80 rounded-2xl py-3 px-4 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-95 shadow-md">
                    <svg class="w-5 h-5 fill-[#1877F2]" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    Facebook
                </button>
            </div>

            <p class="text-center text-slate-400 text-sm mt-8">
                Already have an account? 
                <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-emerald-400 hover:text-emerald-300 font-bold ml-1 transition-all tracking-tight">Sign In Now</a>
            </p>
        </form>
    </div>
</div>
