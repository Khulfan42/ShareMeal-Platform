@using Microsoft.AspNetCore.Identity
@model IdentityUser
@{
    ViewData["Title"] = "Admin Profile & Settings";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-10">
        <h1 class="text-3xl font-black text-white">Admin Security Settings</h1>
        <p class="text-slate-400 mt-2">Manage your platform administrator credentials.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-500/20 border border-emerald-500/50 rounded-xl text-emerald-400 font-bold animate-pulse">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 bg-rose-500/20 border border-rose-500/50 rounded-xl text-rose-400 font-bold">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-rose-500/30 p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-rose-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>

        <form asp-controller="Admin" asp-action="Profile" method="post" asp-antiforgery="true">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="flex flex-col md:flex-row gap-6 mb-8">
                <div class="flex-1">
                    <label class="text-slate-400 font-bold uppercase tracking-widest text-[10px] mb-2 block">Admin Email Address</label>
                    <input type="email" name="email" value="@Model.Email" class="w-full bg-slate-900 border border-slate-700/60 rounded-xl px-4 py-3 text-white font-bold focus:border-rose-500 outline-none transition-all" />
                </div>
                <div class="flex-1">
                    <label class="text-slate-400 font-bold uppercase tracking-widest text-[10px] mb-2 block">New Password (Leave blank to keep current)</label>
                    <input type="password" name="newPassword" class="w-full bg-slate-900 border border-slate-700/60 rounded-xl px-4 py-3 text-white font-bold focus:border-emerald-500 outline-none transition-all" placeholder="••••••••" />
                </div>
            </div>

            <div class="space-y-4">
                <p class="text-slate-300 text-sm italic">Note: Password changes take effect immediately on next login.</p>
                
                <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-slate-700/50 mt-4">
                    <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 px-8 rounded-xl shadow-lg border border-emerald-500 transition-all items-center flex justify-center gap-3">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Save Profile Changes
                    </button>

                    <a asp-controller="Admin" asp-action="Dashboard" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white font-bold py-4 px-8 rounded-xl shadow-lg border border-slate-600 transition-all items-center flex justify-center gap-3">
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </form>
        
        <div class="mt-6 pt-6 border-t border-slate-700/50 text-center">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="text-rose-400 hover:text-rose-300 font-bold text-sm underline underline-offset-4">Sign Out of Admin Session</button>
            </form>
        </div>
    </div>
</div>
