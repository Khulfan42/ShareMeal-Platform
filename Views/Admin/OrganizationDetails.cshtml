@model ShareMeal.Web.Models.Organization
@{
    ViewData["Title"] = "Organization Details";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-10 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-white">@Model.Name</h1>
            <p class="text-slate-400 mt-2">Comprehensive profile for this @Model.Type</p>
        </div>
        <a asp-action="ManageUsers" class="px-5 py-2.5 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700 hover:text-white transition-colors border border-slate-700">Back</a>
    </div>

    <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-slate-700/50 p-8 shadow-2xl">
        <h3 class="text-xl font-bold text-white mb-6 border-b border-slate-700/50 pb-4">Detailed Information</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-4">
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">Email Address</span>
                    <span class="text-lg font-medium text-slate-200">@Model.ContactEmail</span>
                </div>
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">Phone / WhatsApp</span>
                    <span class="text-lg font-medium text-slate-200">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</span>
                </div>
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">Current Status</span>
                    <span class="inline-flex mt-1 items-center px-3 py-1 rounded-md text-xs font-bold uppercase 
                        @(Model.Status == ShareMeal.Web.Models.OrganizationStatus.Verified ? "bg-emerald-400/10 text-emerald-400 border border-emerald-400/20" : 
                          Model.Status == ShareMeal.Web.Models.OrganizationStatus.Pending ? "bg-amber-400/10 text-amber-400 border border-amber-400/20" : 
                          "bg-slate-400/10 text-slate-400 border border-slate-400/20")">
                        @Model.Status
                    </span>
                    @if(Model.IsSuspended)
                    {
                        <span class="ml-2 inline-flex items-center px-3 py-1 rounded-md text-xs font-bold uppercase bg-rose-400/10 text-rose-400 border border-rose-400/20">Suspended</span>
                    }
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">Full Address</span>
                    <span class="text-lg font-medium text-slate-200">@(string.IsNullOrEmpty(Model.Address) ? "Not Provided" : Model.Address)</span>
                </div>
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">About / Description</span>
                    <span class="text-sm font-medium text-slate-400 max-w-sm block leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description available yet." : Model.Description)
                    </span>
                </div>
                <div>
                    <span class="block text-xs uppercase tracking-widest font-black text-slate-500 mb-1">Date Joined</span>
                    <span class="text-lg font-medium text-slate-200">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>
        
        <div class="mt-10 pt-6 border-t border-slate-700/50 flex space-x-4">
            @if (Model.Status == ShareMeal.Web.Models.OrganizationStatus.Pending || Model.IsSuspended)
            {
                <form asp-action="VerifyOrganization" asp-route-id="@Model.Id" method="post" class="inline">
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-emerald-900/20 transition-all flex items-center gap-2 text-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Verify & Activate
                    </button>
                </form>
            }

            @if (!Model.IsSuspended && Model.Status == ShareMeal.Web.Models.OrganizationStatus.Verified)
            {
                <form asp-action="SuspendOrganization" asp-route-id="@Model.Id" method="post" class="inline">
                    <button type="submit" class="bg-rose-600 hover:bg-rose-500 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-rose-900/20 transition-all flex items-center gap-2 text-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        Suspend Account
                    </button>
                </form>
            }
        </div>
    </div>
</div>
