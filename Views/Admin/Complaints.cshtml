@model IEnumerable<ShareMeal.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Complaints & Queries";
}

<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex justify-between items-end mb-10">
        <div>
            <h1 class="text-3xl font-black text-white">Inbox (<span class="text-emerald-400">@Model.Count()</span>)</h1>
            <p class="text-slate-400 mt-2">Manage incoming queries, feedback, and user complaints.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-slate-700/50 p-20 text-center">
            <h2 class="text-2xl font-bold text-emerald-400 mb-4">Inbox Zero!</h2>
            <p class="text-slate-400">There are currently no active queries or feedback tickets.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var msg in Model)
            {
                <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-6 shadow-lg hover:border-blue-500/50 transition-colors">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-r from-blue-500 to-purple-500 flex items-center justify-center text-white font-bold text-lg shadow-lg">
                                @msg.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white">@msg.FullName</h3>
                                <p class="text-slate-400 text-sm">@msg.Email</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Received On</span>
                            <p class="text-emerald-400 font-semibold text-sm">@msg.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</p>
                        </div>
                    </div>
                    
                    <div class="bg-slate-900/50 border border-slate-700 rounded-xl p-5 mb-4">
                        <p class="text-slate-300 whitespace-pre-wrap">@msg.Message</p>
                    </div>

                    <div class="flex justify-end gap-3">
                        <a href="mailto:@msg.Email" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-4 py-2 rounded-lg transition-transform hover:-translate-y-1">Reply via Email</a>
                        <form asp-action="ResolveComplaint" asp-route-id="@msg.Id" method="post" class="inline">
                            <button type="submit" class="text-emerald-400 hover:text-emerald-300 font-bold text-xs bg-emerald-400/10 px-3 py-1.5 rounded-lg border border-emerald-400/20 transition-all hover:bg-emerald-500 hover:text-white">Resolve</button>
                        </form>
                        <form asp-action="DeleteComplaint" asp-route-id="@msg.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this complaint?');">
                            <button type="submit" class="text-rose-400 hover:text-rose-300 font-bold text-xs bg-rose-400/10 px-3 py-1.5 rounded-lg border border-rose-400/20 transition-all hover:bg-rose-500 hover:text-white">Delete</button>
                        </form>
                        @if (msg.IsResolved)
                        {
                            <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500 text-xs font-bold px-4 py-2 rounded-lg">Resolved ✓</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
