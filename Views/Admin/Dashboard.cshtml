@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-card {
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(244, 63, 94, 0.1);
        transition: all 0.3s ease;
    }
    .admin-card:hover {
        border-color: #f43f5e;
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(244, 63, 94, 0.1);
    }
</style>

<div class="relative min-h-screen bg-slate-950 pt-32 pb-20 px-6">
    <!-- Background Texture -->
    <div class="absolute inset-0 z-0 opacity-10">
        <img src="~/admin_bg.png" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950/80 to-slate-950"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <!-- Hero Header -->
        <div class="mb-16">
            <span class="inline-flex items-center gap-2 bg-rose-500/10 text-rose-500 text-[10px] font-black uppercase tracking-[0.3em] px-4 py-1.5 rounded-full mb-6 border border-rose-500/20 shadow-[0_0_20px_rgba(244,63,94,0.1)]">
                🛡️ Master Governance Panel
            </span>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
                <div>
                    <h1 class="text-5xl md:text-7xl font-black text-white outfit leading-none tracking-tight">Ecosystem <br><span class="text-rose-500">Oversight.</span></h1>
                    <p class="text-slate-400 text-lg mt-6 max-w-xl font-medium leading-relaxed">
                        Audit universal partnerships, monitor real-time marketplace activity, and manage humanitarian impact reports.
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <a asp-action="Reports" class="bg-rose-600 hover:bg-rose-500 text-white font-black py-4 px-8 rounded-2xl shadow-xl flex items-center gap-3">
                        <span>📊 System Reports</span>
                        <span class="text-white/50">→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Metric Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="admin-card p-10 rounded-[2.5rem] border-l-4 border-l-emerald-500">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-6">Total Partners</h3>
                <p class="text-6xl font-black text-white outfit">@ViewBag.TotalUsers <span class="text-emerald-500 text-sm">ACTV</span></p>
            </div>
            
            <div class="admin-card p-10 rounded-[2.5rem] border-l-4 border-l-amber-500">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-6">Global Supply</h3>
                <p class="text-6xl font-black text-white outfit">@ViewBag.TotalDonations <span class="text-amber-500 text-sm">UNIT</span></p>
            </div>

            <div class="admin-card p-10 rounded-[2.5rem] border-l-4 border-l-blue-500">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-6">Audit Status</h3>
                <p class="text-6xl font-black text-white outfit">@ViewBag.SuccessRate% <span class="text-blue-500 text-sm">SAFE</span></p>
            </div>
        </div>

        <!-- Management Directory -->
        <h2 class="text-2xl font-black text-white outfit mb-8 uppercase tracking-widest">Governance Controls</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <a asp-action="ManageRestaurants" class="admin-card p-8 rounded-3xl flex items-center justify-between group">
                <div class="bg-white/5 p-4 rounded-2xl group-hover:bg-rose-500/20 transition-colors">
                    <svg class="h-8 w-8 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                </div>
                <div class="text-right">
                    <h4 class="text-sm font-black text-white mb-1">Vendors</h4>
                    <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Partners</span>
                </div>
            </a>
            
            <a asp-action="ManageCharities" class="admin-card p-8 rounded-3xl flex items-center justify-between group">
                <div class="bg-white/5 p-4 rounded-2xl group-hover:bg-emerald-500/20 transition-colors">
                    <svg class="h-8 w-8 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </div>
                <div class="text-right">
                    <h4 class="text-sm font-black text-white mb-1">NGOs</h4>
                    <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Network</span>
                </div>
            </a>

            <a asp-action="DonationsMonitoring" class="admin-card p-8 rounded-3xl flex items-center justify-between group">
                <div class="bg-white/5 p-4 rounded-2xl group-hover:bg-amber-500/20 transition-colors">
                    <svg class="h-8 w-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                </div>
                <div class="text-right">
                    <h4 class="text-sm font-black text-white mb-1">Monitor</h4>
                    <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Market</span>
                </div>
            </a>

            <a asp-action="Profile" class="admin-card p-8 rounded-3xl flex items-center justify-between group">
                <div class="bg-white/5 p-4 rounded-2xl group-hover:bg-blue-500/20 transition-colors">
                    <svg class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                </div>
                <div class="text-right">
                    <h4 class="text-sm font-black text-white mb-1">Config</h4>
                    <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Master</span>
                </div>
            </a>
        </div>
    </div>
</div>
