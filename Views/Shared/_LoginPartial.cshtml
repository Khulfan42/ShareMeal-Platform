@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="flex items-center gap-4">
@if (SignInManager.IsSignedIn(User))
{
    <div class="flex items-center gap-3">
        <span class="text-white font-black text-[10px]">@User.Identity?.Name</span>
        <form class="form-inline" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="text-[10px] font-black text-rose-500 hover:text-rose-400 uppercase transition-all">Logout</button>
        </form>
    </div>
}
else
{
    <a class="nav-login-btn" asp-controller="Account" asp-action="Login">
        <span>Login</span>
    </a>
    <a class="nav-join-btn group" asp-controller="Account" asp-action="Register">
        <span>Join Now</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
    </a>
}
</div>
