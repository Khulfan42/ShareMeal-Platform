<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShareMeal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #2ecc71;
            --brand-secondary: #f39c12;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #020611;
            color: #f8fafc;
            overflow-x: hidden;
        }

        .outfit { font-family: 'Outfit', sans-serif; }

        .glass-nav {
            background: rgba(2, 6, 17, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .hero-title {
            font-size: clamp(3rem, 8vw, 6rem);
            line-height: 1.1;
            font-weight: 900;
        }

        .btn-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            transition: all 0.3s ease;
        }

        .btn-emerald:hover {
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.4);
            transform: translateY(-2px);
        }

        .btn-outline {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: white;
        }

        .dev-card-glow {
            box-shadow: 0 0 50px rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .blink-pill {
            animation: pill-glow 3s infinite;
        }
        @@keyframes pill-glow {
            0%, 100% { border-color: rgba(255, 255, 255, 0.05); box-shadow: 0 0 0px rgba(16, 185, 129, 0); }
            50% { border-color: rgba(16, 185, 129, 0.5); box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); }
        }

        .nav-link-premium {
            position: relative;
            transition: all 0.3s ease;
        }
        .nav-link-premium::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: #10b981;
            transition: width 0.3s ease;
        }
        .nav-link-premium:hover {
            color: #10b981;
            text-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
        }
        .nav-link-premium:hover::after {
            width: 100%;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #020617; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
    </style>
</head>
<body class="selection:bg-emerald-500 selection:text-white">

    <!-- Global Dark Background System -->
    @if (ViewData["BackgroundImage"] != null)
    {
        <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
            <img src="@ViewData["BackgroundImage"]" class="w-full h-full object-cover opacity-40 filter brightness-[0.5] contrast-[1.1]" alt="Background" />
            <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/80 to-slate-950"></div>
        </div>
    }

    <header class="fixed top-0 inset-x-0 z-50 glass-nav">
        <nav class="max-w-[1400px] mx-auto px-6 py-4 flex items-center justify-between">
            <!-- Logo & Dev Pill -->
            <div class="flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                    <div class="bg-emerald-500 p-2 rounded-xl">
                        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                    </div>
                    <span class="text-2xl font-black outfit tracking-tighter text-white">Share<span class="text-emerald-500">Meal</span></span>
                </a>
                <a asp-controller="Home" asp-action="Developer" class="flex items-center gap-2 bg-slate-800/50 px-3 py-1.5 rounded-full border border-white/5 group transition-all blink-pill">
                    <img src="~/dev_pic.png" class="w-4 h-4 rounded-full object-cover" />
                    <span class="text-[9px] font-black uppercase tracking-widest text-slate-300">Hi, Khulfan</span>
                </a>
            </div>

            <!-- Central Links -->
            <div class="hidden lg:flex items-center gap-6 text-[10px] font-black uppercase tracking-widest text-slate-300">
                <a asp-controller="Home" asp-action="HowItWorks" class="nav-link-premium">How It Works</a>
                <a asp-controller="Home" asp-action="About" class="nav-link-premium">About Us</a>
                <a asp-controller="Home" asp-action="Contact" class="nav-link-premium">Contact</a>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3">
                    <a asp-controller="Donations" asp-action="Index" class="text-[10px] font-black text-emerald-500 hover:text-emerald-400 uppercase tracking-widest px-2">Marketplace</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Restaurant") || User.IsInRole("Admin"))
                        {
                            <a asp-controller="Restaurant" asp-action="Dashboard" class="bg-orange-600 hover:bg-orange-500 text-white text-[9px] font-black px-4 py-2 rounded-lg transition-all shadow-lg shadow-orange-600/20">Restaurant Panel</a>
                        }
                        @if (User.IsInRole("Charity") || User.IsInRole("Admin"))
                        {
                            <a asp-controller="Charity" asp-action="Dashboard" class="bg-blue-600 hover:bg-blue-500 text-white text-[9px] font-black px-4 py-2 rounded-lg transition-all shadow-lg shadow-blue-600/20">Charity Panel</a>
                        }
                    }
                    @* Admin Panel always visible as private gate *@
                    <a asp-controller="Admin" asp-action="Login" title="Admin Panel – Private Access Only" class="bg-rose-600 hover:bg-rose-500 text-white text-[9px] font-black px-4 py-2 rounded-lg transition-all shadow-lg shadow-rose-600/20">Admin Panel</a>
                </div>
                <div class="w-px h-6 bg-white/10"></div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-slate-950 border-t border-white/5 py-16">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <h2 class="text-2xl font-black outfit mb-6">Share<span class="text-emerald-500">Meal</span></h2>
            <div class="flex justify-center gap-8 text-[10px] font-black uppercase tracking-widest text-slate-500 mb-8">
                <a href="#" class="hover:text-white">Privacy Policy</a>
                <a href="#" class="hover:text-white">Terms of Service</a>
                <a href="#" class="hover:text-white">Partner Program</a>
            </div>
            <p class="text-slate-600 text-[10px] font-bold tracking-[0.3em] uppercase">Built Proudly by Muhammad Khulfan &copy; @DateTime.Now.Year</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
