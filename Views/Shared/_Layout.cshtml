    <!-- MealBot Chat Script -->
    <script>
        function toggleMealBot() {
            var win = document.getElementById("mealbot-window");
            var iconOpen = document.getElementById("mealbot-icon-open");
            var iconClose = document.getElementById("mealbot-icon-close");
            var teaser = document.getElementById("mealbot-teaser");

            if (teaser) teaser.style.display = "none";

            if (win.classList.contains("hidden")) {
                win.classList.remove("hidden");
                setTimeout(function() {
                    win.classList.remove("scale-95", "opacity-0");
                    win.classList.add("scale-100", "opacity-100");
                    document.getElementById("mealbot-input").focus();
                }, 10);
                iconOpen.classList.add("hidden");
                iconClose.classList.remove("hidden");
            } else {
                win.classList.remove("scale-100", "opacity-100");
                win.classList.add("scale-95", "opacity-0");
                setTimeout(function() {
                    win.classList.add("hidden");
                }, 200);
                iconOpen.classList.remove("hidden");
                iconClose.classList.add("hidden");
            }
        }

        function clearMealBotChat() {
            var log = document.getElementById("mealbot-messages");
            log.innerHTML = `
                <div class="bg-gradient-to-br from-slate-900/90 to-slate-850 border border-emerald-500/20 p-4 rounded-2xl shadow-md text-center text-slate-300 text-xs">
                    <span class="text-xl mb-1 block">🧹</span>
                    <strong>Chat Cleared!</strong><br/>
                    Ask anything about available food, NGOs, or restaurant donations.
                </div>
            `;
        }

        function sendQuickPrompt(promptText) {
            document.getElementById("mealbot-input").value = promptText;
            sendMealBotMessage();
        }

        function sendMealBotMessage() {
            var input = document.getElementById("mealbot-input");
            var message = input.value.trim();
            if (!message) return;

            var log = document.getElementById("mealbot-messages");
            var typing = document.getElementById("mealbot-typing");
            var nowTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // Append User Message with stylish bubble
            var userBubble = document.createElement("div");
            userBubble.className = "flex justify-end items-end gap-2 animate-in fade-in slide-in-from-bottom-2 duration-200";
            userBubble.innerHTML = `
                <div class="flex flex-col items-end max-w-[85%]">
                    <div class="bg-gradient-to-r from-emerald-600 via-emerald-600 to-teal-600 text-white px-4 py-3 rounded-2xl rounded-tr-xs shadow-md shadow-emerald-950/40 text-xs font-medium leading-relaxed break-words">
                        ${escapeHtml(message)}
                    </div>
                    <span class="text-[9px] text-slate-500 mt-1 mr-1 font-semibold">${nowTime}</span>
                </div>
            `;
            log.appendChild(userBubble);
            input.value = "";
            log.scrollTop = log.scrollHeight;

            // Show typing indicator
            typing.classList.remove("hidden");
            log.scrollTop = log.scrollHeight;

            // Call Backend Controller
            fetch("/AiAssistant/Chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ message: message })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                typing.classList.add("hidden");
                var botBubble = document.createElement("div");
                botBubble.className = "flex items-start gap-2.5 animate-in fade-in slide-in-from-bottom-2 duration-300";
                var replyHtml = formatBotResponse(data.reply || "No response received.");
                var messageId = "bot-msg-" + Date.now();
                var botTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                botBubble.innerHTML = `
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-sm flex-shrink-0 shadow-md border border-emerald-400/30">
                        🤖
                    </div>
                    <div class="flex flex-col max-w-[86%]">
                        <div id="${messageId}" class="bg-slate-900/90 border border-emerald-500/25 text-slate-100 p-4 rounded-2xl rounded-tl-xs shadow-xl leading-relaxed text-xs backdrop-blur-sm">
                            ${replyHtml}
                        </div>
                        <div class="flex items-center justify-between mt-1 px-1 text-[9px] text-slate-500 font-semibold">
                            <span>${botTime}</span>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="speakBotMessage('${messageId}', this)" class="text-slate-400 hover:text-emerald-300 flex items-center gap-1 transition-colors" title="Voice Note suniye">
                                    <span>🔊</span>
                                    <span class="speak-label">Listen</span>
                                </button>
                                <button type="button" onclick="copyBotMessage('${messageId}', this)" class="text-slate-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                    <span>Copy</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                log.appendChild(botBubble);
                log.scrollTop = log.scrollHeight;
            })
            .catch(function(err) {
                typing.classList.add("hidden");
                var errBubble = document.createElement("div");
                errBubble.className = "flex gap-2.5 items-start animate-in fade-in";
                errBubble.innerHTML = `
                    <div class="w-8 h-8 rounded-xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-sm flex-shrink-0">
                        ⚠️
                    </div>
                    <div class="bg-rose-950/40 border border-rose-500/30 text-rose-200 p-3.5 rounded-2xl rounded-tl-xs max-w-[85%] leading-relaxed text-xs">
                        Network interruption. Please check your connection and try again.
                    </div>
                `;
                log.appendChild(errBubble);
                log.scrollTop = log.scrollHeight;
            });
        }

        // --- Voice Note (Speech-to-Text & Text-to-Speech) System ---
        var mealBotRecognition = null;
        var isMealBotRecording = false;
        var activeSpeechBtn = null;
        var currentSpeechLang = 'ur-PK'; // Default: Urdu (ur-PK), can be switched to English (en-US)

        function setSpeechLanguage(lang) {
            currentSpeechLang = lang;
            var btnUr = document.getElementById("lang-btn-ur");
            var btnEn = document.getElementById("lang-btn-en");
            var voiceLabel = document.getElementById("mealbot-voice-label");
            var input = document.getElementById("mealbot-input");

            if (lang === 'ur-PK') {
                if (btnUr) {
                    btnUr.className = "px-2 py-0.5 text-[9.5px] font-black rounded-lg bg-emerald-600 text-white transition-all shadow-sm";
                }
                if (btnEn) {
                    btnEn.className = "px-2 py-0.5 text-[9.5px] font-black rounded-lg text-slate-400 hover:text-slate-200 transition-all";
                }
                if (voiceLabel) {
                    voiceLabel.innerText = "🎙️ Listening in Urdu (اردو)... Bolna shuru karein!";
                }
                if (input && !input.value) {
                    input.placeholder = "Urdu mein bolein ya likhein...";
                }
            } else {
                if (btnEn) {
                    btnEn.className = "px-2 py-0.5 text-[9.5px] font-black rounded-lg bg-emerald-600 text-white transition-all shadow-sm";
                }
                if (btnUr) {
                    btnUr.className = "px-2 py-0.5 text-[9.5px] font-black rounded-lg text-slate-400 hover:text-slate-200 transition-all";
                }
                if (voiceLabel) {
                    voiceLabel.innerText = "🎙️ Listening in English... Start speaking!";
                }
                if (input && !input.value) {
                    input.placeholder = "Speak or type in English...";
                }
            }

            // If recognition is active, stop it so next start picks up new language
            if (mealBotRecognition && isMealBotRecording) {
                stopSpeechRecording();
            }
        }

        function initMealBotSpeech() {
            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) return null;

            var recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = true;
            recognition.lang = currentSpeechLang;

            recognition.onstart = function() {
                isMealBotRecording = true;
                updateRecordingUI(true);
                var doneAlert = document.getElementById("mealbot-voice-done");
                if (doneAlert) doneAlert.classList.add("hidden");
            };

            recognition.onresult = function(event) {
                var transcript = "";
                for (var i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript;
                }
                var input = document.getElementById("mealbot-input");
                if (input && transcript) {
                    input.value = transcript;
                }
            };

            recognition.onerror = function(event) {
                console.warn("Speech recognition error:", event.error);
                stopSpeechRecording();
                if (event.error === 'not-allowed') {
                    alert("Microphone permission required! Please allow microphone access in your browser settings to speak.");
                }
            };

            recognition.onend = function() {
                isMealBotRecording = false;
                updateRecordingUI(false);

                // DO NOT AUTO-SEND! Keep the text in input so the user can review/edit and send manually
                var input = document.getElementById("mealbot-input");
                if (input && input.value.trim().length > 0) {
                    input.focus();
                    var doneAlert = document.getElementById("mealbot-voice-done");
                    if (doneAlert) {
                        doneAlert.classList.remove("hidden");
                    }
                    var sendBtn = document.getElementById("mealbot-send-btn");
                    if (sendBtn) {
                        sendBtn.classList.add("ring-2", "ring-emerald-400", "scale-105");
                        setTimeout(function() {
                            sendBtn.classList.remove("ring-2", "ring-emerald-400", "scale-105");
                        }, 2500);
                    }
                }
            };

            return recognition;
        }

        function toggleSpeechRecording() {
            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Voice feature ke liye please Google Chrome, Edge, ya Safari browser use karein.");
                return;
            }

            if (isMealBotRecording) {
                stopSpeechRecording();
            } else {
                startSpeechRecording();
            }
        }

        function startSpeechRecording() {
            try {
                if (mealBotRecognition) {
                    try { mealBotRecognition.abort(); } catch(e) {}
                }
                mealBotRecognition = initMealBotSpeech();
                if (mealBotRecognition) {
                    mealBotRecognition.lang = currentSpeechLang;
                    var input = document.getElementById("mealbot-input");
                    if (input) input.value = "";
                    mealBotRecognition.start();
                }
            } catch (e) {
                console.error("Error starting speech recognition:", e);
                stopSpeechRecording();
            }
        }

        function stopSpeechRecording() {
            if (mealBotRecognition && isMealBotRecording) {
                try {
                    mealBotRecognition.stop();
                } catch(e) {}
            }
            isMealBotRecording = false;
            updateRecordingUI(false);
        }

        function updateRecordingUI(recording) {
            var normalIcon = document.getElementById("mic-icon-normal");
            var recIcon = document.getElementById("mic-icon-recording");
            var voiceBar = document.getElementById("mealbot-voice-bar");
            var micBtn = document.getElementById("mealbot-mic-btn");

            if (recording) {
                if (normalIcon) normalIcon.classList.add("hidden");
                if (recIcon) recIcon.classList.remove("hidden");
                if (voiceBar) voiceBar.classList.remove("hidden");
                if (micBtn) {
                    micBtn.classList.add("bg-rose-600", "border-rose-400", "scale-105", "shadow-rose-600/40");
                    micBtn.classList.remove("bg-slate-800/90", "border-slate-700/80");
                }
            } else {
                if (normalIcon) normalIcon.classList.remove("hidden");
                if (recIcon) recIcon.classList.add("hidden");
                if (voiceBar) voiceBar.classList.add("hidden");
                if (micBtn) {
                    micBtn.classList.remove("bg-rose-600", "border-rose-400", "scale-105", "shadow-rose-600/40");
                    micBtn.classList.add("bg-slate-800/90", "border-slate-700/80");
                }
            }
        }

        function speakBotMessage(elementId, btn) {
            if (!('speechSynthesis' in window)) {
                alert("Text-to-speech aapke browser mein available nahi hai.");
                return;
            }

            if (window.speechSynthesis.speaking) {
                window.speechSynthesis.cancel();
                if (activeSpeechBtn) {
                    var prevLabel = activeSpeechBtn.querySelector(".speak-label");
                    var prevIcon = activeSpeechBtn.querySelector("span:first-child");
                    if (prevLabel) prevLabel.innerText = "Listen";
                    if (prevIcon) prevIcon.innerText = "🔊";
                }
                if (activeSpeechBtn === btn) {
                    activeSpeechBtn = null;
                    return;
                }
            }

            var el = document.getElementById(elementId);
            if (!el) return;

            var text = el.innerText;
            var utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = 1.0;
            utterance.pitch = 1.0;

            // Check if text contains Urdu script characters
            var hasUrduScript = /[\u0600-\u06FF]/.test(text);

            var voices = window.speechSynthesis.getVoices();
            var matchedVoice = null;

            if (hasUrduScript) {
                matchedVoice = voices.find(function(v) { return v.lang && (v.lang.startsWith("ur") || v.lang.startsWith("hi")); });
            } else {
                matchedVoice = voices.find(function(v) { return v.lang && v.lang.startsWith("en"); });
            }

            if (matchedVoice) {
                utterance.voice = matchedVoice;
            }

            var label = btn.querySelector(".speak-label");
            var icon = btn.querySelector("span:first-child");
            if (label) label.innerText = "Stop";
            if (icon) icon.innerText = "⏹️";
            activeSpeechBtn = btn;

            utterance.onend = function() {
                if (label) label.innerText = "Listen";
                if (icon) icon.innerText = "🔊";
                activeSpeechBtn = null;
            };

            utterance.onerror = function() {
                if (label) label.innerText = "Listen";
                if (icon) icon.innerText = "🔊";
                activeSpeechBtn = null;
            };

            window.speechSynthesis.speak(utterance);
        }

        function copyBotMessage(elementId, btn) {
            var el = document.getElementById(elementId);
            if (!el) return;
            var text = el.innerText;
            navigator.clipboard.writeText(text).then(function() {
                var origHtml = btn.innerHTML;
                btn.innerHTML = `<span class="text-emerald-400 font-bold">✓ Copied!</span>`;
                setTimeout(function() {
                    btn.innerHTML = origHtml;
                }, 2000);
            });
        }

        function escapeHtml(text) {
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function formatBotResponse(text) {
            var escaped = escapeHtml(text);

            // Bold styling with emerald highlight
            escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="text-emerald-300 font-bold">$1</strong>');
            
            // Format numbers like 1. 2. 3.
            escaped = escaped.replace(/(?:^|\n)(\d+)\.\s+(.*?)(?=\n|$)/g, '<div class="flex items-start gap-2 my-1.5"><span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 font-extrabold text-[9px] border border-emerald-500/40 flex-shrink-0 mt-0.5">$1</span><span>$2</span></div>');

            // Format bullet points
            escaped = escaped.replace(/(?:^|\n)\s*[\*\-]\s+(.*?)(?=\n|$)/g, '<div class="flex items-start gap-2 my-1 pl-1"><span class="text-emerald-400 font-bold text-xs leading-none mt-1">•</span><span>$1</span></div>');

            // Normal newlines
            escaped = escaped.replace(/\n/g, '<br/>');

            return escaped;
        }

        function toggleMobileMenu() {
            var menu = document.getElementById('mobileMenu');
            var hamburger = document.getElementById('hamburgerIcon');
            var close = document.getElementById('closeIcon');
            if (!menu) return;
            var isHidden = menu.classList.contains('hidden');
            if (isHidden) {
                menu.classList.remove('hidden');
                if (hamburger) hamburger.classList.add('hidden');
                if (close) close.classList.remove('hidden');
            } else {
                menu.classList.add('hidden');
                if (hamburger) hamburger.classList.remove('hidden');
                if (close) close.classList.add('hidden');
            }
        }

        // Close mobile drawer on desktop resize (>= 1280px)
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 1280) {
                var menu = document.getElementById('mobileMenu');
                var hamburger = document.getElementById('hamburgerIcon');
                var close = document.getElementById('closeIcon');
                if (menu && !menu.classList.contains('hidden')) {
                    menu.classList.add('hidden');
                    if (hamburger) hamburger.classList.remove('hidden');
                    if (close) close.classList.add('hidden');
                }
            }
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
