<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShareMeal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #2ecc71;
            --brand-secondary: #f39c12;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #020611;
            color: #f8fafc;
            overflow-x: hidden;
        }

        .outfit { font-family: 'Outfit', sans-serif; }

        .glass-nav {
            background: rgba(2, 6, 17, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .hero-title {
            font-size: clamp(3rem, 8vw, 6rem);
            line-height: 1.1;
            font-weight: 900;
        }

        .btn-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            transition: all 0.3s ease;
        }

        .btn-emerald:hover {
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.4);
            transform: translateY(-2px);
        }

        .btn-outline {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: white;
        }

        .dev-card-glow {
            box-shadow: 0 0 50px rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .blink-pill {
            animation: pill-glow 3s infinite;
        }
        @@keyframes pill-glow {
            0%, 100% { border-color: rgba(255, 255, 255, 0.05); box-shadow: 0 0 0px rgba(16, 185, 129, 0); }
            50% { border-color: rgba(16, 185, 129, 0.5); box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); }
        }

        .glass-nav {
            background: rgba(2, 6, 17, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-capsule {
            color: #cbd5e1;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.45rem 0.85rem;
            border-radius: 9999px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            display: inline-flex;
            align-items: center;
            border: 1px solid transparent;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        .nav-capsule:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.18);
        }

        .nav-capsule.active, .nav-capsule:active {
            color: #34d399;
            background: rgba(16, 185, 129, 0.12);
            border-color: rgba(16, 185, 129, 0.3);
        }

        .nav-admin-btn {
            color: #94a3b8;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.45rem 0.8rem;
            border-radius: 9999px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.03);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        .nav-admin-btn:hover {
            color: #fb7185;
            background: rgba(244, 63, 94, 0.12);
            border-color: rgba(244, 63, 94, 0.35);
            box-shadow: 0 0 15px rgba(244, 63, 94, 0.25);
            transform: translateY(-1px);
        }

        .nav-login-btn {
            color: #cbd5e1;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.5rem 1.1rem;
            border-radius: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.03);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        .nav-login-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.25);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.08);
            transform: translateY(-1px);
        }

        .nav-join-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.5rem 1.3rem;
            border-radius: 0.85rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        .nav-join-btn:hover {
            background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
            box-shadow: 0 6px 25px rgba(16, 185, 129, 0.55);
            transform: translateY(-1px) scale(1.03);
        }

        .nav-join-btn:active {
            transform: translateY(0) scale(0.98);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #020617; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
    </style>
</head>
<body class="selection:bg-emerald-500 selection:text-white">

    <!-- Global Dark Background System -->
    @if (ViewData["BackgroundImage"] != null)
    {
        <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
            <img src="@ViewData["BackgroundImage"]" class="w-full h-full object-cover opacity-40 filter brightness-[0.5] contrast-[1.1]" alt="Background" />
            <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/80 to-slate-950"></div>
        </div>
    }

    <header class="fixed top-0 inset-x-0 z-50 glass-nav">
        <nav class="max-w-[1440px] mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
            <!-- Brand & AI Assistant -->
            <div class="flex items-center gap-3 flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group flex-shrink-0">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-500/25 group-hover:scale-105 group-hover:shadow-emerald-500/40 transition-all duration-300">
                        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                    </div>
                    <span class="text-xl sm:text-2xl font-black outfit tracking-tighter text-white whitespace-nowrap">Share<span class="text-emerald-400">Meal</span></span>
                </a>
                <!-- AI Assistant launcher: shown on 2xl screens (or can be opened from floating bot or mobile drawer) -->
                <button type="button" onclick="toggleMealBot()" class="hidden 2xl:inline-flex items-center gap-2 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 hover:text-emerald-100 border border-emerald-500/30 hover:border-emerald-400/60 px-3 py-1.5 rounded-full transition-all shadow-sm hover:shadow-[0_0_15px_rgba(16,185,129,0.3)] transform hover:scale-105 active:scale-95 whitespace-nowrap flex-shrink-0" title="Open AI Assistant">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span class="text-[10px] font-extrabold uppercase tracking-wider flex items-center gap-1 whitespace-nowrap"><span>🤖</span><span>AI Assistant</span></span>
                    <span class="text-[8px] bg-emerald-500/25 text-emerald-200 border border-emerald-400/30 px-1.5 py-0.2 rounded-full font-black whitespace-nowrap">LIVE</span>
                </button>
            </div>

            <!-- Central Nav — visible on xl (1280px+) screens -->
            <div class="hidden xl:flex items-center gap-1 bg-white/5 border border-white/10 rounded-full px-2 py-1 backdrop-blur-xl flex-shrink-0 whitespace-nowrap">
                <a asp-controller="Home" asp-action="HowItWorks" class="nav-capsule whitespace-nowrap">How It Works</a>
                <a asp-controller="Home" asp-action="About" class="nav-capsule whitespace-nowrap">About Us</a>
                <a asp-controller="Home" asp-action="Contact" class="nav-capsule whitespace-nowrap">Contact</a>
                <a asp-controller="Donations" asp-action="Index" class="nav-capsule text-emerald-400 hover:text-emerald-300 whitespace-nowrap">
                    <span class="mr-1">🥗</span><span>Marketplace</span>
                </a>
                <!-- Portals Dropdown -->
                <div class="relative group">
                    <button type="button" class="nav-capsule flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
                        <span>Portals</span>
                        <svg class="w-3 h-3 text-slate-400 group-hover:text-emerald-400 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="absolute left-0 top-full pt-2.5 w-64 hidden group-hover:block z-50">
                        <div class="bg-slate-900/95 backdrop-blur-2xl border border-white/10 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8)] p-2 space-y-1">
                            <a asp-controller="Restaurant" asp-action="Dashboard" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-orange-500/10 text-slate-300 hover:text-orange-400 transition-all group/item">
                                <span class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center text-sm group-hover/item:scale-110 transition-transform">🍽️</span>
                                <div class="text-left">
                                    <div class="text-white font-bold text-xs">Restaurant Portal</div>
                                    <div class="text-[9px] text-slate-400 font-medium">Hotel &amp; Kitchen Donors</div>
                                </div>
                            </a>
                            <a asp-controller="Charity" asp-action="Dashboard" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-blue-500/10 text-slate-300 hover:text-blue-400 transition-all group/item">
                                <span class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm group-hover/item:scale-110 transition-transform">🤝</span>
                                <div class="text-left">
                                    <div class="text-white font-bold text-xs">Charity &amp; NGO Portal</div>
                                    <div class="text-[9px] text-slate-400 font-medium">Welfare Claims &amp; Distribution</div>
                                </div>
                            </a>
                            <div class="border-t border-white/5 my-1"></div>
                            <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-rose-500/10 text-slate-300 hover:text-rose-400 transition-all group/item">
                                <span class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center text-sm group-hover/item:scale-110 transition-transform">🛡️</span>
                                <div class="text-left">
                                    <div class="text-white font-bold text-xs">Admin Control Center</div>
                                    <div class="text-[9px] text-slate-400 font-medium">KYC Vetting &amp; System</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Desktop auth + Hamburger -->
            <div class="flex items-center gap-2 flex-shrink-0">
                <!-- Desktop auth — only on xl (1280px+) -->
                <div class="hidden xl:flex items-center gap-2 flex-shrink-0 whitespace-nowrap">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Restaurant"))
                        {
                            <a asp-controller="Restaurant" asp-action="Dashboard" class="bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-400 hover:to-amber-500 text-white text-[11px] font-extrabold px-3.5 py-1.5 rounded-xl transition-all shadow-md shadow-orange-600/30 flex items-center gap-1.5 whitespace-nowrap">
                                <span>🍽️</span><span>Restaurant Panel</span>
                            </a>
                        }
                        @if (User.IsInRole("Charity"))
                        {
                            <a asp-controller="Charity" asp-action="Dashboard" class="bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 text-white text-[11px] font-extrabold px-3.5 py-1.5 rounded-xl transition-all shadow-md shadow-blue-600/30 flex items-center gap-1.5 whitespace-nowrap">
                                <span>🤝</span><span>Charity Panel</span>
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-400 hover:to-red-500 text-white text-[11px] font-extrabold px-3.5 py-1.5 rounded-xl transition-all shadow-md shadow-rose-600/30 flex items-center gap-1.5 whitespace-nowrap">
                                <span>👑</span><span>Admin Panel</span>
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Admin" asp-action="Login" class="nav-admin-btn whitespace-nowrap"><span>🛡️</span><span>Admin</span></a>
                    }
                    <div class="w-px h-5 bg-white/10"></div>
                    <partial name="_LoginPartial" />
                </div>

                <!-- Hamburger button — visible on any screen < 1280px (mobile, tablet, smaller laptop) -->
                <button type="button" id="mobileMenuBtn" onclick="toggleMobileMenu()"
                        class="xl:hidden flex items-center justify-center w-10 h-10 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition-all text-slate-300 hover:text-white active:scale-95 flex-shrink-0"
                        title="Toggle Navigation Menu">
                    <svg id="hamburgerIcon" class="w-5 h-5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg id="closeIcon" class="w-5 h-5 hidden transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </nav>

        <!-- Mobile Slide-Down Drawer -->
        <div id="mobileMenu" class="hidden xl:hidden border-t border-white/8 bg-[#020611]/98 backdrop-blur-2xl px-4 py-4 space-y-1.5 max-h-[85vh] overflow-y-auto shadow-2xl">
            <!-- Navigation Links -->
            <a asp-controller="Home" asp-action="HowItWorks" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/8 text-sm font-bold uppercase tracking-wide transition-all">
                📖 How It Works
            </a>
            <a asp-controller="Home" asp-action="About" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/8 text-sm font-bold uppercase tracking-wide transition-all">
                ℹ️ About Us
            </a>
            <a asp-controller="Home" asp-action="Contact" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-white hover:bg-white/8 text-sm font-bold uppercase tracking-wide transition-all">
                📬 Contact
            </a>
            <a asp-controller="Donations" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 text-sm font-bold uppercase tracking-wide transition-all">
                🥗 Marketplace
            </a>

            <!-- Portals Section -->
            <div class="border-t border-white/8 pt-3 mt-2">
                <p class="text-[9px] font-black uppercase tracking-widest text-slate-500 px-4 mb-2">Access Portals</p>
                <a asp-controller="Restaurant" asp-action="Dashboard" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-orange-400 hover:bg-orange-500/10 text-sm font-bold transition-all">
                    🍽️ Restaurant Portal
                </a>
                <a asp-controller="Charity" asp-action="Dashboard" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-blue-400 hover:bg-blue-500/10 text-sm font-bold transition-all">
                    🤝 Charity &amp; NGO Portal
                </a>
                <a asp-controller="Admin" asp-action="Login" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:text-rose-400 hover:bg-rose-500/10 text-sm font-bold transition-all">
                    🛡️ Admin Portal
                </a>
            </div>

            <!-- Authentication Section -->
            <div class="border-t border-white/8 pt-3 mt-2 space-y-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="text-[9px] font-black uppercase tracking-widest text-slate-500 px-4">Account</p>
                    <p class="text-slate-400 text-xs px-4">Signed in as <strong class="text-emerald-400">@User.Identity?.Name</strong></p>
                    <form class="form-inline" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="w-full text-rose-400 hover:text-rose-300 text-sm font-black uppercase tracking-wider py-2.5 rounded-2xl bg-rose-500/10 hover:bg-rose-500/20 transition-all text-center">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <a asp-controller="Account" asp-action="Login" class="flex items-center justify-center border border-white/15 bg-white/5 hover:bg-white/10 text-white text-xs font-black uppercase tracking-wider py-3 rounded-2xl transition-all">
                            Login
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="flex items-center justify-center gap-1.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white text-xs font-black uppercase tracking-wider py-3 rounded-2xl shadow-lg shadow-emerald-600/30 transition-all">
                            <span>Join Now</span>
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                        </a>
                    </div>
                }
            </div>

            <!-- AI Assistant Mobile Button -->
            <div class="border-t border-white/8 pt-3 mt-2">
                <button type="button" onclick="toggleMealBot(); toggleMobileMenu();" class="flex items-center justify-center gap-2.5 w-full px-4 py-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm font-bold hover:bg-emerald-500/20 transition-all">
                    <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>
                    <span>🤖 Open MealBot AI Assistant</span>
                    <span class="text-[9px] bg-emerald-500/25 text-emerald-200 border border-emerald-400/30 px-1.5 py-0.2 rounded-full font-black">LIVE</span>
                </button>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-[#020611]/92 backdrop-blur-2xl border-t border-white/10 py-16 relative z-20 shadow-[0_-10px_40px_rgba(0,0,0,0.7)]">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 mb-6 group">
                <div class="bg-emerald-500 p-2 rounded-xl group-hover:scale-105 transition-transform shadow-lg shadow-emerald-500/20">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                </div>
                <span class="text-3xl font-black outfit tracking-tighter text-white">Share<span class="text-emerald-400">Meal</span></span>
            </a>

            <!-- Quick Links -->
            <div class="flex flex-wrap justify-center gap-8 text-xs font-black uppercase tracking-widest text-slate-200 mb-8">
                <a asp-controller="Home" asp-action="HowItWorks" class="hover:text-emerald-400 transition-colors">How It Works</a>
                <a asp-controller="Home" asp-action="About" class="hover:text-emerald-400 transition-colors">About Us</a>
                <a asp-controller="Home" asp-action="Contact" class="hover:text-emerald-400 transition-colors">Contact</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-emerald-400 transition-colors">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Developer" class="hover:text-emerald-400 transition-colors">Developer Profile</a>
            </div>

            <!-- Built Proudly By Muhammad Khulfan Credit Line -->
            <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-4xl mx-auto">
                <p class="text-slate-300 text-xs font-bold tracking-wider">
                    Built Proudly by <span class="text-emerald-400 font-extrabold">Muhammad Khulfan</span> &copy; @DateTime.Now.Year
                </p>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-400 text-[11px] font-mono font-semibold uppercase tracking-wider">Zero Waste Initiative • Pakistan</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ============================================= -->
    <!-- SHAREMEAL AI ASSISTANT (MEALBOT) ULTRA-PREMIUM WIDGET -->
    <!-- ============================================= -->
    <div id="mealbot-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end font-sans">
        
        <!-- Interactive Teaser / Announcement Bubble (Auto-catches attention) -->
        <div id="mealbot-teaser" onclick="toggleMealBot()" 
