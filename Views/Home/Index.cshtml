                <span class="bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">Quetta</span>
                <span class="bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">Gujranwala</span>
                <span class="bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">Sialkot</span>
                <span class="bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">Hyderabad</span>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const bgDivs = document.querySelectorAll('.hero-bg-div');
        
        function updateDisplay(index) {
            slides.forEach((s, idx) => {
                if(idx === index) s.classList.add('active');
                else s.classList.remove('active');
            });
            bgDivs.forEach((bg, idx) => {
                if(idx === index) bg.classList.add('active');
                else bg.classList.remove('active');
            });
        }
        
        window.changeHeroSlide = function(direction) {
            if(direction === 'next') {
                currentSlide = (currentSlide + 1) % slides.length;
            } else {
                currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            }
            updateDisplay(currentSlide);
        };
        
        setInterval(() => changeHeroSlide('next'), 6000);

        // Continuous Global Background Food Circulation
        const bgFoodSlides = document.querySelectorAll('.bg-food-slide');
        if (bgFoodSlides.length > 0) {
            let bgIndex = 0;
            setInterval(() => {
                bgFoodSlides[bgIndex].classList.remove('active');
                bgIndex = (bgIndex + 1) % bgFoodSlides.length;
                bgFoodSlides[bgIndex].classList.add('active');
            }, 5500);
        }
    });
</script>
