@model ShareMeal.Web.Models.HomeStatsViewModel
@{
    ViewData["Title"] = "ShareMeal - Universal Food Redistribution";
}

<style>
    .hero-title-main {
        font-family: 'Outfit', sans-serif;
        font-size: clamp(3.5rem, 9vw, 7rem);
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: -0.04em;
        text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .text-lime-brand { color: #bef264; }
    
    /* Dynamic Global Food Circulation Background System */
    .bg-food-circulation-container {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .bg-food-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 2s ease-in-out, transform 8s ease-out;
        transform: scale(1.05);
        background-size: cover;
        background-position: center;
        filter: brightness(0.62) contrast(1.12) saturate(1.25);
    }
    .bg-food-slide.active {
        opacity: 0.52;
        transform: scale(1);
    }
    
    .bg-charity-theme {
        position: relative;
        z-index: 10;
        background: transparent;
    }
    
    .carousel-slide {
        display: none;
        animation: fadeIn 1.2s ease-in-out forwards;
    }
    .carousel-slide.active { display: block; }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .hero-bg-div {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
        background-size: cover;
        background-position: center;
    }
    .hero-bg-div.active { opacity: 0.4; }

    .btn-hero-donate {
        background-color: #4ead7c;
        border-radius: 1.25rem;
        transition: all 0.3s ease;
    }
    .btn-hero-donate:hover { background-color: #3e9668; transform: scale(1.02); }
    
    .btn-hero-find {
        background-color: #1a2333;
        border-radius: 1.25rem;
        transition: all 0.3s ease;
    }
    .btn-hero-find:hover { background-color: #242f45; transform: scale(1.02); }

    .feature-card {
        background: rgba(30, 41, 59, 0.3);
        backdrop-filter: blur(20px);
        transition: all 0.3s ease;
    }
    .feature-card:hover { transform: translateX(10px); background: rgba(30, 41, 59, 0.5); }

    /* Infinite Marquee Food Circulation Showcase */
    @@keyframes marquee-scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .food-marquee-container {
        display: flex;
        overflow: hidden;
        user-select: none;
        mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }
    .food-marquee-track {
        display: flex;
        gap: 1.5rem;
        flex-shrink: 0;
        animation: marquee-scroll 35s linear infinite;
        will-change: transform;
    }
    .food-marquee-container:hover .food-marquee-track {
        animation-play-state: paused;
    }
    .food-card-glass {
        background: rgba(13, 20, 33, 0.72);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .food-card-glass:hover {
        border-color: rgba(16, 185, 129, 0.5);
        box-shadow: 0 16px 36px -10px rgba(16, 185, 129, 0.25);
        transform: translateY(-5px);
    }
</style>

<!-- GLOBAL FOOD CIRCULATION BACKGROUND (Continuous Smooth Fade) -->
<div class="bg-food-circulation-container" aria-hidden="true">
    <div class="bg-food-slide active" style="background-image: url('/carousel_1.png');"></div>
    <div class="bg-food-slide" style="background-image: url('/food_serving.png');"></div>
    <div class="bg-food-slide" style="background-image: url('/carousel_2.png');"></div>
    <div class="bg-food-slide" style="background-image: url('/charity_hero_premium.png');"></div>
    <div class="bg-food-slide" style="background-image: url('/carousel_3.png');"></div>
    <div class="bg-food-slide" style="background-image: url('/restaurant_bg.png');"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#020611]/55 via-[#020611]/70 to-[#020611]/85 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(16,185,129,0.2),transparent_70%)] pointer-events-none"></div>
</div>

<div class="bg-charity-theme">
    <!-- SECTION 1: HERO -->
    <div class="relative min-h-[90vh] flex items-center overflow-hidden pt-20">
        <!-- Background Image Slides -->
        <div id="hero-bg-container" class="absolute inset-0 z-0 bg-black">
            <div class="hero-bg-div active" style="background-image: url('/food_serving.png');"></div>
            <div class="hero-bg-div" style="background-image: url('/charity_hero.png');"></div>
            <div class="hero-bg-div" style="background-image: url('/charity_joy.png');"></div>
            <div class="hero-bg-div" style="background-image: url('/restaurant_bg.png');"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#020611] via-[#020611]/60 to-transparent"></div>
        </div>

        <div class="max-w-[1400px] mx-auto px-8 w-full relative z-30 py-20 text-center lg:text-left">
            <div class="max-w-4xl">
                <!-- Impact Badge -->
                <div class="inline-flex items-center gap-3 bg-[#f39c12]/20 border border-[#f39c12]/30 px-5 py-2 rounded-full mb-8 self-start">
                    <div class="w-2 h-2 bg-[#f39c12] rounded-full animate-pulse"></div>
                    <span class="text-[#f39c12] text-[10px] font-black uppercase tracking-[0.2em] outfit">REAL-TIME IMPACT: @ViewBag.TotalDonations MEALS SAVED</span>
                </div>

                <!-- 4-Slide Animated Content -->
                <div id="hero-text-carousel">
                    <!-- Slide 1 -->
                    <div class="carousel-slide active">
                        <h1 class="hero-title-main text-white mb-10">
                            Zero Waste,<br>
                            <span class="text-lime-brand">Zero Hunger.</span>
                        </h1>
                    </div>
                    <!-- Slide 2 -->
                    <div class="carousel-slide">
                        <h1 class="hero-title-main text-white mb-10">
                            Connect. <span class="text-emerald-500">Claim.</span><br>
                            Feed the Needy.
                        </h1>
                    </div>
                    <!-- Slide 3 -->
                    <div class="carousel-slide">
                        <h1 class="hero-title-main text-white mb-10">
                            Scale Your <br>
                            <span class="text-blue-500">Humanitarian</span> Impact.
                        </h1>
                    </div>
                    <!-- Slide 4 -->
                    <div class="carousel-slide">
                        <h1 class="hero-title-main text-white mb-10">
                            The Smart <br>
                            <span class="text-rose-500">Redistribution</span> Hub.
                        </h1>
                    </div>
                </div>
                
                <p class="text-slate-300 text-xl font-medium max-w-2xl leading-relaxed mb-16 mx-auto lg:mx-0">
                    The central bridge connecting restaurants with surplus food to charitable organizations. Together, we turn waste into nourishment.
                </p>

                <div class="flex flex-wrap gap-6 mb-16 justify-center lg:justify-start">
                    @if (User.IsInRole("Restaurant") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="Donations" asp-action="Create" class="btn-hero-donate text-white font-bold py-6 px-12 text-xl">🥗 Donate Food →</a>
                    }
                    <a asp-controller="Donations" asp-action="Index" class="btn-hero-find text-white font-bold py-6 px-12 text-xl">🍽️ Find Food</a>
                </div>

                <!-- Controls -->
                <div class="flex gap-4 justify-center lg:justify-start">
                    <button onclick="changeHeroSlide('prev')" class="w-14 h-14 rounded-full bg-white/5 border border-white/10 text-white hover:bg-emerald-500 transition-all flex items-center justify-center text-xl">←</button>
                    <button onclick="changeHeroSlide('next')" class="w-14 h-14 rounded-full bg-white/5 border border-white/10 text-white hover:bg-emerald-500 transition-all flex items-center justify-center text-xl">→</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: OUR MISSION & NATIONWIDE IMPACT -->
    <div class="py-24 px-6 md:px-8 relative overflow-hidden">
        <!-- Ambient Glowing Backdrop -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-6xl mx-auto relative z-10">
            <!-- Section Header -->
            <div class="text-center max-w-4xl mx-auto mb-16">
                <div class="inline-flex items-center gap-2 bg-rose-500/10 text-rose-400 border border-rose-500/30 px-6 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-8 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                    <span>OUR HUMANITARIAN MISSION</span>
                </div>
                <h2 class="text-5xl md:text-7xl font-black outfit text-white leading-[1.05] mb-8">
                    <span class="text-rose-500">Millions</span> Go Hungry.<br>
                    Together, We Deliver Hope.
                </h2>
                <p class="text-slate-300 text-lg md:text-xl font-medium leading-relaxed max-w-3xl mx-auto mb-10">
                    While banquets, restaurants, and catering services produce tons of untouched surplus food daily, impoverished families in our neighborhoods go to sleep hungry. ShareMeal bridges this gap with zero waste, maximum speed, and complete dignity.
                </p>

                <!-- Floating Food Category Badges -->
                <div class="flex flex-wrap justify-center gap-3">
                    <span class="px-4 py-2 rounded-full bg-slate-900/80 border border-white/10 text-slate-200 text-xs font-bold flex items-center gap-2 shadow-sm">
                        <span>🍛</span> Hot Biryani & Buffet Trays
                    </span>
                    <span class="px-4 py-2 rounded-full bg-slate-900/80 border border-white/10 text-slate-200 text-xs font-bold flex items-center gap-2 shadow-sm">
                        <span>🥖</span> Fresh Bakery & Breads
                    </span>
                    <span class="px-4 py-2 rounded-full bg-slate-900/80 border border-white/10 text-slate-200 text-xs font-bold flex items-center gap-2 shadow-sm">
                        <span>🥗</span> Farm Fresh Produce & Fruits
                    </span>
                    <span class="px-4 py-2 rounded-full bg-slate-900/80 border border-white/10 text-slate-200 text-xs font-bold flex items-center gap-2 shadow-sm">
                        <span>🥛</span> Milk & Dairy Essentials
                    </span>
                    <span class="px-4 py-2 rounded-full bg-slate-900/80 border border-white/10 text-slate-200 text-xs font-bold flex items-center gap-2 shadow-sm">
                        <span>📦</span> Family Ration Care Packs
                    </span>
                </div>
            </div>

            <!-- 4-Card Mission Impact Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
                <!-- Card 1 -->
                <div class="food-card-glass p-7 rounded-[2.5rem] border border-white/10 relative overflow-hidden group hover:border-emerald-500/50 transition-all shadow-xl">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform">
                        🍲
                    </div>
                    <span class="text-emerald-400 text-[10px] font-black uppercase tracking-widest block mb-2">Hospitality Food Recovery</span>
                    <h4 class="text-white font-extrabold text-xl outfit mb-3">Hotel & Banquet Surplus</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Untouched trays from weddings, corporate banquets, and buffets packaged in safe thermal carriers within 30 minutes.</p>
                    <div class="mt-4 pt-4 border-t border-white/5 text-[11px] font-mono text-emerald-300 flex items-center justify-between">
                        <span>Saved: 15,000+ kg</span>
                        <span>⚡ Rapid Route</span>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="food-card-glass p-7 rounded-[2.5rem] border border-white/10 relative overflow-hidden group hover:border-amber-500/50 transition-all shadow-xl">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform">
                        🤲
                    </div>
                    <span class="text-amber-400 text-[10px] font-black uppercase tracking-widest block mb-2">Community Kitchens</span>
                    <h4 class="text-white font-extrabold text-xl outfit mb-3">Daily Dastarkhwan Relief</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Dispatched directly to free food dastarkhwans and roadside shelters feeding daily-wage workers and children.</p>
                    <div class="mt-4 pt-4 border-t border-white/5 text-[11px] font-mono text-amber-300 flex items-center justify-between">
                        <span>Served: 12,000+ meals</span>
                        <span>💚 100% Free</span>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="food-card-glass p-7 rounded-[2.5rem] border border-white/10 relative overflow-hidden group hover:border-blue-500/50 transition-all shadow-xl">
                    <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform">
                        🏢
                    </div>
                    <span class="text-blue-400 text-[10px] font-black uppercase tracking-widest block mb-2">Verified Charities</span>
                    <h4 class="text-white font-extrabold text-xl outfit mb-3">38+ Registered NGOs</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Saylani, Edhi, Al-Khidmat, and Chhipa receive instant notifications with live donor GPS locations for quick pickup.</p>
                    <div class="mt-4 pt-4 border-t border-white/5 text-[11px] font-mono text-blue-300 flex items-center justify-between">
                        <span>11 Cities Active</span>
                        <span>📍 Nationwide</span>
                    </div>
                </div>

                <!-- Card 4 -->
                <div class="food-card-glass p-7 rounded-[2.5rem] border border-white/10 relative overflow-hidden group hover:border-purple-500/50 transition-all shadow-xl">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform">
                        🛡️
                    </div>
                    <span class="text-purple-400 text-[10px] font-black uppercase tracking-widest block mb-2">Quality & Dignity</span>
                    <h4 class="text-white font-extrabold text-xl outfit mb-3">Food Safety Certified</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Rigorous hygiene checklist, safe temperature handling, and verified volunteer handovers maintain dignity.</p>
                    <div class="mt-4 pt-4 border-t border-white/5 text-[11px] font-mono text-purple-300 flex items-center justify-between">
                        <span>Zero Waste Target</span>
                        <span>✅ 100% Inspected</span>
                    </div>
                </div>
            </div>

            <!-- Redistribution Step Banner (How It Flows) -->
            <div class="bg-gradient-to-r from-slate-900/90 via-slate-800/90 to-slate-900/90 border border-white/10 rounded-3xl p-6 md:p-8 backdrop-blur-xl flex flex-col lg:flex-row items-center justify-between gap-6 shadow-2xl">
                <div class="flex items-center gap-4">
                    <span class="text-4xl">🔄</span>
                    <div>
                        <h4 class="text-white font-black text-lg outfit">The 4-Step Zero-Waste Cycle</h4>
                        <p class="text-slate-400 text-xs">How a surplus dish turns into a hot meal on someone's plate in under 45 minutes</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3 text-xs font-bold text-slate-300">
                    <span class="bg-white/5 px-4 py-2.5 rounded-xl border border-white/10 flex items-center gap-2 text-emerald-400">
                        <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-[10px] font-black">1</span>
                        Post Surplus
                    </span>
                    <span class="text-slate-600">➔</span>
                    <span class="bg-white/5 px-4 py-2.5 rounded-xl border border-white/10 flex items-center gap-2 text-blue-400">
                        <span class="w-5 h-5 rounded-full bg-blue-500/20 text-blue-300 flex items-center justify-center text-[10px] font-black">2</span>
                        Charity Claims
                    </span>
                    <span class="text-slate-600">➔</span>
                    <span class="bg-white/5 px-4 py-2.5 rounded-xl border border-white/10 flex items-center gap-2 text-amber-400">
                        <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center text-[10px] font-black">3</span>
                        Fast Pickup
                    </span>
                    <span class="text-slate-600">➔</span>
                    <span class="bg-white/5 px-4 py-2.5 rounded-xl border border-white/10 flex items-center gap-2 text-rose-400">
                        <span class="w-5 h-5 rounded-full bg-rose-500/20 text-rose-300 flex items-center justify-center text-[10px] font-black">4</span>
                        Dignified Meal
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURES -->
    <div class="py-32 px-8">
        <div class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div class="relative rounded-[4rem] overflow-hidden shadow-2xl"><img src="/food_serving.png" class="w-full h-full object-cover" /><div class="absolute bottom-12 left-12"><p class="text-white text-3xl font-black outfit leading-tight">Every Meal<br>Counts.</p></div></div>
            <div class="space-y-12">
                <h2 class="text-4xl md:text-6xl font-black text-white outfit leading-tight mb-16">Everything You Need <br>to Save Meals</h2>
                <div class="space-y-6">
                    <div class="feature-card p-8 rounded-[2.5rem] flex items-center gap-8 text-white"><div class="text-3xl">📍</div><div><h4 class="text-xl font-black mb-2">Nearby Donations</h4><p class="text-slate-400 text-sm">Find surplus food listings from restaurants right in your neighborhood.</p></div></div>
                    <div class="feature-card p-8 rounded-[2.5rem] flex items-center gap-8 text-white"><div class="text-3xl">🔔</div><div><h4 class="text-xl font-black mb-2">Instant Alerts</h4><p class="text-slate-400 text-sm">NGOs get notified immediately when fresh food becomes available.</p></div></div>
                    <div class="feature-card p-8 rounded-[2.5rem] flex items-center gap-8 text-white"><div class="text-3xl">🛡️</div><div><h4 class="text-xl font-black mb-2">Verified Partners</h4><p class="text-slate-400 text-sm">Every organization is manually verified to ensure food safety.</p></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 4: FOOD WASTE AWARENESS & IMPACT VIDEO -->
    <div class="py-24 px-6 md:px-8 relative overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="max-w-6xl mx-auto text-center relative z-10">
            <div class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-6 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-6 shadow-sm">
                <span>🎬</span>
                <span>EDUCATIONAL & SOCIAL IMPACT</span>
            </div>
            <h2 class="text-4xl md:text-6xl font-black text-white outfit mb-6">Reduce Food Waste & Feed Communities</h2>
            <p class="text-slate-300 text-base md:text-lg font-medium max-w-2xl mx-auto mb-12">
                Discover the reality of food loss and how technology connects surplus donors to starving communities within minutes.
            </p>
            <div class="aspect-video max-w-[850px] mx-auto rounded-[2.5rem] overflow-hidden border-8 border-white/10 shadow-2xl relative group hover:border-emerald-500/30 transition-all">
                <iframe class="w-full h-full" 
                        src="https://www.youtube.com/embed/ishA6kry8nc" 
                        title="Food Waste Awareness" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                </iframe>
            </div>

            <!-- 3 Key Takeaway Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto mt-12">
                <div class="food-card-glass p-6 rounded-3xl border border-white/10 text-left">
                    <span class="text-2xl mb-2 block">🌾</span>
                    <h4 class="text-white font-bold text-base outfit mb-1">36M Tons Wasted</h4>
                    <p class="text-slate-400 text-xs">Massive food loss occurs annually across hotels, banquets, and supply chains in Pakistan.</p>
                </div>
                <div class="food-card-glass p-6 rounded-3xl border border-white/10 text-left">
                    <span class="text-2xl mb-2 block">👶</span>
                    <h4 class="text-white font-bold text-base outfit mb-1">40% Child Malnutrition</h4>
                    <p class="text-slate-400 text-xs">Millions face food insecurity while usable untouched meals are dumped into city landfills.</p>
                </div>
                <div class="food-card-glass p-6 rounded-3xl border border-white/10 text-left">
                    <span class="text-2xl mb-2 block">💡</span>
                    <h4 class="text-white font-bold text-base outfit mb-1">The ShareMeal Solution</h4>
                    <p class="text-slate-400 text-xs">Direct GPS matching transfers hot meals from commercial kitchens to needy hands in 45 mins.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 5: LIVE FOOD CIRCULATION & COMMUNITY IMPACT SHOWCASE -->
    <div class="py-28 px-4 relative overflow-hidden">
        <div class="max-w-6xl mx-auto text-center mb-14 px-4">
            <div class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-5 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-6 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span>🔄 24/7 LIVE FOOD CIRCULATION NETWORK</span>
            </div>
            <h2 class="text-4xl md:text-6xl font-black text-white outfit leading-tight mb-6">
                Surplus Meals <span class="text-emerald-400">In Continuous Motion</span>
            </h2>
            <p class="text-slate-300 text-base md:text-lg max-w-3xl mx-auto font-medium leading-relaxed">
                Watch how hotels, bakeries, and banquet halls connect instantly with registered charity dastarkhwans across Pakistan — transforming surplus into life-saving nourishment.
            </p>
        </div>

        <!-- Infinite Food Circulation Marquee -->
        <div class="food-marquee-container py-4 mb-16">
            <div class="food-marquee-track">
                <!-- Card 1 -->
                <div class="food-card-glass w-[330px] rounded-3xl p-4 flex-shrink-0 flex flex-col justify-between">
                    <div class="relative h-48 rounded-2xl overflow-hidden mb-4 group">
                        <img src="/carousel_1.png" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" alt="Hot Banquet Meals" />
                        <div class="absolute top-3 left-3 bg-[#0a2e24]/90 backdrop-blur-md text-[#10b981] border border-[#10b981]/30 text-[9px] font-black uppercase px-2.5 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Multan Active Drop</span>
                        </div>
                        <div class="absolute bottom-2 right-2 bg-black/75 backdrop-blur-sm text-amber-300 text-[10px] font-extrabold px-2.5 py-1 rounded-lg border border-amber-400/20">
                            ⚡ 240 Servings
                        </div>
