@{
    Layout = null;
    ViewData["Title"] = "ShareMeal - Final Year Project Presentation";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShareMeal Platform — FYP Final Presentation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #020617; color: white; overflow: hidden; user-select: none; }

        .slide { display: none; width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; opacity: 0; transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out; }
        .slide.active { display: flex; opacity: 1; transform: scale(1); }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes slideLeft { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
        @@keyframes slideRight { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
        @@keyframes scaleIn { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
        @@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
        @@keyframes pulse-glow { 0%,100% { box-shadow: 0 0 25px rgba(16,185,129,0.25); } 50% { box-shadow: 0 0 60px rgba(16,185,129,0.65), 0 0 100px rgba(16,185,129,0.3); } }
        @@keyframes rotate-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

        .anim-delay-1 { animation-delay: 0.15s; animation-fill-mode: both; }
        .anim-delay-2 { animation-delay: 0.3s; animation-fill-mode: both; }
        .anim-delay-3 { animation-delay: 0.45s; animation-fill-mode: both; }
        .anim-delay-4 { animation-delay: 0.6s; animation-fill-mode: both; }

        .slide-left { animation: slideLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .slide-right { animation: slideRight 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .scale-in { animation: scaleIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .fade-up { animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }

        .float-anim { animation: float 4s ease-in-out infinite; }
        .pulse-glow { animation: pulse-glow 2.5s ease-in-out infinite; }
        .rotate-slow { animation: rotate-slow 28s linear infinite; }

        .glass { background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.08); }
        .glass-emerald { background: rgba(6, 78, 59, 0.3); backdrop-filter: blur(24px); border: 1px solid rgba(16, 185, 129, 0.35); }
        .glass-blue { background: rgba(30, 58, 138, 0.3); backdrop-filter: blur(24px); border: 1px solid rgba(59, 130, 246, 0.35); }
        .glass-purple { background: rgba(88, 28, 135, 0.3); backdrop-filter: blur(24px); border: 1px solid rgba(168, 85, 247, 0.35); }
        .glass-gold { background: rgba(120, 53, 15, 0.3); backdrop-filter: blur(24px); border: 1px solid rgba(245, 158, 11, 0.35); }

        .gradient-text { background: linear-gradient(135deg, #10b981 0%, #38bdf8 50%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .gradient-gold { background: linear-gradient(135deg, #fbbf24 0%, #f97316 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .bg-grid { background-image: linear-gradient(rgba(16,185,129,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(16,185,129,0.05) 1px, transparent 1px); background-size: 40px 40px; }
        .bg-dots { background-image: radial-gradient(rgba(59,130,246,0.12) 1px, transparent 1px); background-size: 28px 28px; }

        .progress-bar { position: fixed; bottom: 0; left: 0; height: 5px; background: linear-gradient(90deg, #10b981, #38bdf8, #a855f7); transition: width 0.4s ease; z-index: 100; }
        .slide-counter { position: fixed; bottom: 18px; right: 24px; font-size: 13px; color: rgba(255,255,255,0.5); z-index: 100; font-weight: 700; letter-spacing: 2px; font-mono; }

        .nav-btn { position: fixed; z-index: 100; width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.25s; border: 1px solid rgba(255,255,255,0.15); background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(12px); color: white; font-size: 16px; }
        .nav-btn:hover { background: rgba(16,185,129,0.3); border-color: #10b981; transform: scale(1.1); }

        .feature-card { transition: all 0.3s ease; }
        .feature-card:hover { transform: translateY(-5px) scale(1.015); }

        .tech-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; transition: all 0.25s; }
        .tech-badge:hover { transform: translateY(-2px); }

        .orbit-ring { position: absolute; border-radius: 50%; border: 1px dashed rgba(16,185,129,0.2); animation: rotate-slow 35s linear infinite; pointer-events: none; }
        .orbit-ring-2 { animation-duration: 45s; animation-direction: reverse; border-color: rgba(56,189,248,0.18); }
    </style>
</head>
<body class="bg-[#020617]">

<!-- ─── TOP CONTROL BAR (Discreet & Powerful) ─────────────────────── -->
<div style="position:fixed;top:16px;left:20px;right:20px;z-index:100;display:flex;align-items:center;justify-content:between;pointer-events:none;">
    <!-- Left: Home link -->
    <a href="/" class="nav-btn" style="position:static;pointer-events:auto;width:42px;height:42px;font-size:14px;" title="Back to ShareMeal Platform">
        <i class="fas fa-arrow-left"></i>
    </a>

    <!-- Center: Quick indicator badge -->
    <div class="glass px-4 py-1.5 rounded-full text-xs font-bold text-slate-300 flex items-center gap-2 border border-white/10" style="pointer-events:auto;">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>ShareMeal FYP Presentation</span>
        <span class="text-slate-500">•</span>
        <span class="text-emerald-400">USP Multan</span>
    </div>

    <!-- Right: PPTX Download & Controls -->
    <div style="display:flex;align-items:center;gap:10px;pointer-events:auto;">
        <!-- Table of Contents shortcut -->
        <button onclick="goToSlide(2)" class="px-3.5 py-2 rounded-full glass hover:border-emerald-400 text-xs font-bold text-slate-200 transition-all flex items-center gap-1.5 shadow-lg" title="Table of Contents">
            <i class="fas fa-list text-emerald-400"></i> Index
        </button>

        <!-- Direct PPTX Download Button -->
        <a href="/Home/DownloadPresentation" class="px-4 py-2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-xs transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/20 transform hover:scale-105" title="Download Official PowerPoint (.pptx)">
            <i class="fas fa-file-powerpoint text-sm"></i> Download PPTX
        </a>

        <!-- PDF Print -->
        <button onclick="window.print()" class="w-10 h-10 rounded-full glass hover:border-blue-400 text-slate-200 flex items-center justify-center transition-all text-sm" title="Print as PDF">
            <i class="fas fa-file-pdf text-blue-400"></i>
        </button>

        <!-- Fullscreen -->
        <button onclick="toggleFullscreen()" class="w-10 h-10 rounded-full glass hover:border-purple-400 text-slate-200 flex items-center justify-center transition-all text-sm" title="Toggle Fullscreen (F)">
            <i class="fas fa-expand text-purple-400"></i>
        </button>
    </div>
</div>

<!-- Navigation Arrows -->
<button class="nav-btn" style="left:20px;top:50%;transform:translateY(-50%)" onclick="changeSlide(-1)" id="prevBtn" title="Previous Slide (←)">
    <i class="fas fa-chevron-left"></i>
</button>
<button class="nav-btn" style="right:20px;top:50%;transform:translateY(-50%)" onclick="changeSlide(1)" id="nextBtn" title="Next Slide (→)">
    <i class="fas fa-chevron-right"></i>
</button>

<!-- Bottom Progress & Hints -->
<div class="progress-bar" id="progressBar"></div>
<div class="slide-counter" id="slideCounter">01 / 13</div>
<div style="position:fixed;bottom:18px;left:50%;transform:translateX(-50%);font-size:11px;color:rgba(255,255,255,0.3);z-index:100;letter-spacing:1px;font-weight:600;">
    USE ARROW KEYS [← →] OR SPACEBAR &nbsp;|&nbsp; PRESS [F] FOR FULLSCREEN
</div>


