                    <div class="text-xs text-blue-400 font-semibold mb-3">ASP.NET Core Controllers</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        AccountController, RestaurantController, CharityController, AdminController & GeminiAiService.
                    </p>
                </div>

                <!-- Data Layer -->
                <div class="card p-6 text-center border-t-4 border-purple-400">
                    <div class="text-3xl mb-2">🗄️</div>
                    <h3 class="text-base font-bold text-white mb-1">Data Storage Layer</h3>
                    <div class="text-xs text-purple-400 font-semibold mb-3">Entity Framework & SQLite</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Relational tables for Organizations, Donations, Contact Messages & ASP.NET Identity Users.
                    </p>
                </div>
            </div>

            <div class="card p-4 text-center">
                <p class="text-xs text-slate-400">
                    ⚡ <strong>Request Flow:</strong> User Browser ➔ Controller Action ➔ Model Validation ➔ DbContext Query ➔ Rendered HTML View
                </p>
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 6: CORE USER WORKFLOWS
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-6">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Section 04</span>
