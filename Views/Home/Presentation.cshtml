                    <div class="text-xs text-emerald-400 font-semibold mb-3">Razor Views (.cshtml)</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Tailwind CSS responsive interfaces, JavaScript voice recognition, and interactive forms for users.
                    </p>
                </div>

                <!-- Business Logic Layer -->
