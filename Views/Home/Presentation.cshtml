                <p class="text-slate-400 text-sm mt-1">Three distinct dedicated portals</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Restaurant -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl mb-4">
                        🍽️
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">1. Restaurant</h3>
                    <ul class="text-xs text-slate-300 space-y-2">
                        <li class="flex items-start gap-2">✓ <span>Register restaurant profile</span></li>
                        <li class="flex items-start gap-2">✓ <span>Post food: Item name, quantity, expiry</span></li>
                        <li class="flex items-start gap-2">✓ <span>Monitor which charity claimed the meal</span></li>
                        <li class="flex items-start gap-2">✓ <span>Mark donation as collected</span></li>
                    </ul>
                </div>

                <!-- Charity -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-2xl bg-blue-500/20 text-blue-400 flex items-center justify-center text-2xl mb-4">
                        🤲
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">2. Charity / NGO</h3>
                    <ul class="text-xs text-slate-300 space-y-2">
                        <li class="flex items-start gap-2">✓ <span>Register shelter or charity</span></li>
                        <li class="flex items-start gap-2">✓ <span>Browse live marketplace of available food</span></li>
                        <li class="flex items-start gap-2">✓ <span>Claim meal package with single click</span></li>
                        <li class="flex items-start gap-2">✓ <span>Coordinate pickup with donor restaurant</span></li>
                    </ul>
                </div>

                <!-- Admin -->
                <div class="card p-6">
                    <div class="w-12 h-12 rounded-2xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-2xl mb-4">
                        👑
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">3. Admin</h3>
                    <ul class="text-xs text-slate-300 space-y-2">
