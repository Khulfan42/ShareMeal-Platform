@{
    Layout = null;
    ViewData["Title"] = "ShareMeal - Final Year Project Defense";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShareMeal Platform — FYP Final Defense Presentation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap');
        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: #060911; 
            color: #f1f5f9; 
            overflow: hidden; 
            user-select: none;
        }

        h1, h2, h3, h4, .title-font {
            font-family: 'Outfit', sans-serif;
        }

        /* Slide Transitions */
        .slide { 
            display: none; 
            width: 100vw; 
            height: 100vh; 
            position: absolute; 
            top: 0; 
            left: 0; 
            opacity: 0; 
            transform: scale(0.985);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .slide.active { 
            display: flex; 
            opacity: 1; 
            transform: scale(1);
        }

        /* Clean animations */
        .anim-item {
            opacity: 0;
            transform: translateY(18px);
            animation: slideUp 0.45s ease forwards;
        }
        .anim-item:nth-child(1) { animation-delay: 0.1s; }
        .anim-item:nth-child(2) { animation-delay: 0.2s; }
        .anim-item:nth-child(3) { animation-delay: 0.3s; }
        .anim-item:nth-child(4) { animation-delay: 0.4s; }
        .anim-item:nth-child(5) { animation-delay: 0.5s; }

        @@keyframes slideUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Glass Cards */
        .card {
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        .card:hover {
            border-color: rgba(16, 185, 129, 0.4);
            transform: translateY(-3px);
        }

        .card-emerald {
            background: rgba(6, 78, 59, 0.25);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .card-rose {
            background: rgba(136, 19, 55, 0.25);
            border: 1px solid rgba(244, 63, 94, 0.3);
        }
        .card-blue {
            background: rgba(30, 58, 138, 0.25);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
        .card-amber {
            background: rgba(120, 53, 15, 0.25);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* Carousel inside presentation */
        .slider-img {
            display: none;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
        }
        .slider-img.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Controls */
        .nav-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .nav-btn:hover {
            background: #10b981;
            color: #090d16;
            border-color: #10b981;
            transform: scale(1.08);
        }

        .progress-line {
            position: fixed;
            bottom: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(90deg, #10b981, #38bdf8, #f59e0b);
            transition: width 0.3s ease;
            z-index: 50;
        }

        .badge-academic {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
        }

        .gradient-title {
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gradient-emerald {
            background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body>

    <!-- ── TOP BAR (Clean, discreet & academic) ────────────────────── -->
    <header class="fixed top-0 left-0 right-0 z-50 px-6 py-4 flex items-center justify-between pointer-events-none">
        <!-- Return Link -->
        <a href="/" class="nav-btn pointer-events-auto" title="Return to Website">
            <i class="fas fa-arrow-left text-sm"></i>
        </a>

        <!-- Academic Header Tag -->
        <div class="px-4 py-1.5 rounded-full card text-xs font-semibold text-slate-300 flex items-center gap-2 pointer-events-auto border border-white/10 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Final Year Project (FYP)</span>
            <span class="text-slate-600">•</span>
            <span>University of Southern Punjab, Multan</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 pointer-events-auto">
            <!-- Table of contents button -->
            <button onclick="goToSlide(2)" class="px-3.5 py-2 rounded-full card hover:border-emerald-400 text-xs font-semibold text-slate-200 transition-all flex items-center gap-1.5" title="Go to Agenda">
                <i class="fas fa-list text-emerald-400"></i>
                <span>Agenda</span>
            </button>

            <!-- Direct PPTX Download -->
            <a href="/Home/DownloadPresentation" class="px-4 py-2 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/20" title="Download PowerPoint File (.pptx)">
                <i class="fas fa-file-powerpoint"></i>
                <span>Download PPTX</span>
            </a>

            <!-- Fullscreen -->
            <button onclick="toggleFullscreen()" class="nav-btn" title="Toggle Fullscreen (F)">
                <i class="fas fa-expand text-sm"></i>
            </button>
        </div>
    </header>

    <!-- Side Navigation Arrows -->
    <button class="nav-btn fixed left-5 top-1/2 -translate-y-1/2 z-40" onclick="changeSlide(-1)" id="prevBtn" title="Previous Slide (←)">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button class="nav-btn fixed right-5 top-1/2 -translate-y-1/2 z-40" onclick="changeSlide(1)" id="nextBtn" title="Next Slide (→)">
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Progress & Slide Indicator -->
    <div class="progress-line" id="progressBar"></div>
    <div class="fixed bottom-4 right-6 text-xs font-bold text-slate-400 font-mono z-40" id="slideCounter">
        01 / 13
    </div>
    <div class="fixed bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-slate-500 font-medium tracking-wide z-40">
        Use Arrow Keys [← →] or Spacebar to Navigate &nbsp;|&nbsp; Press [F] for Fullscreen
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 1: FORMAL TITLE COVER
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide active flex-col items-center justify-center text-center px-6" id="slide-1" style="background: radial-gradient(circle at center, #0f1c2e 0%, #060911 100%);">
        <div class="max-w-4xl mx-auto w-full">
            
            <!-- University Name & Department -->
            <div class="anim-item inline-flex items-center gap-2 px-5 py-2 rounded-full badge-academic text-xs font-bold uppercase tracking-wider mb-6">
                <span>🏛️</span> Department of Computer Science • University of Southern Punjab, Multan
            </div>

            <!-- Project Title -->
            <h1 class="anim-item text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-4">
                ShareMeal <span class="gradient-emerald">Platform</span>
            </h1>

            <!-- Subtitle -->
            <p class="anim-item text-base sm:text-xl text-slate-300 font-medium max-w-2xl mx-auto mb-10 leading-relaxed">
                A Web-Based Surplus Food Redistribution & Zero-Hunger Management System
            </p>

            <!-- Formal Defense Details Grid -->
            <div class="anim-item grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto text-left mb-8">
                <!-- Presented By -->
                <div class="card p-5 border-emerald-500/30">
                    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 block mb-1">Presented By</span>
                    <h3 class="text-lg font-bold text-white mb-0.5">Muhammad Khulfan</h3>
                    <h3 class="text-lg font-bold text-white mb-2">Abdullah Khalid</h3>
                    <p class="text-xs text-slate-400">BS Computer Science (BSCS) • Final Year Project</p>
                </div>

                <!-- Supervised By -->
                <div class="card p-5 border-amber-500/30">
                    <span class="text-[10px] font-black uppercase tracking-widest text-amber-400 block mb-1">Supervised By</span>
                    <h3 class="text-xl font-bold text-white mb-1">Miss Kainat Sajid</h3>
                    <p class="text-[11px] text-amber-300 font-semibold mt-1">M.Phil in Computer Science • Lecturer</p>
                    <p class="text-xs text-slate-400 mt-1">Department of Computer Science</p>
                    <p class="text-xs text-amber-400 font-medium">Faculty of Computing & IT</p>
                </div>
            </div>

            <div class="anim-item text-xs text-slate-500 font-medium">
                Academic Session 2024–2026 • Final Project Defense
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 2: AGENDA
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-2">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Presentation Roadmap</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">Table of Contents</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div onclick="goToSlide(3)" class="card p-4 cursor-pointer hover:border-rose-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm">01</span>
                    <div>
                        <div class="text-sm font-bold text-white">The Crisis: Hunger & Survival</div>
                        <div class="text-xs text-slate-400">Real dilemma in Pakistan with video evidence</div>
                    </div>
                </div>

                <div onclick="goToSlide(4)" class="card p-4 cursor-pointer hover:border-amber-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm">02</span>
                    <div>
                        <div class="text-sm font-bold text-white">How Food is Provided</div>
                        <div class="text-xs text-slate-400">From surplus kitchen to shelter plates</div>
                    </div>
                </div>

                <div onclick="goToSlide(5)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">03</span>
                    <div>
                        <div class="text-sm font-bold text-white">ShareMeal Solution</div>
                        <div class="text-xs text-slate-400">4 operational pillars bridging the gap</div>
                    </div>
                </div>

                <div onclick="goToSlide(6)" class="card p-4 cursor-pointer hover:border-blue-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm">04</span>
                    <div>
                        <div class="text-sm font-bold text-white">System Architecture</div>
                        <div class="text-xs text-slate-400">MVC pattern, data flow & security</div>
                    </div>
                </div>

                <div onclick="goToSlide(7)" class="card p-4 cursor-pointer hover:border-purple-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-sm">05</span>
                    <div>
                        <div class="text-sm font-bold text-white">Core User Roles</div>
                        <div class="text-xs text-slate-400">Restaurant, Charity and Admin workflows</div>
                    </div>
                </div>

                <div onclick="goToSlide(8)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">06</span>
                    <div>
                        <div class="text-sm font-bold text-white">Technology Stack</div>
                        <div class="text-xs text-slate-400">ASP.NET Core 8, Tailwind, SQLite, Docker</div>
                    </div>
                </div>

                <div onclick="goToSlide(9)" class="card p-4 cursor-pointer hover:border-purple-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-sm">07</span>
                    <div>
                        <div class="text-sm font-bold text-white">MealBot Gemini AI & Voice</div>
                        <div class="text-xs text-slate-400">Roman Urdu NLP + Web Speech Voice API</div>
                    </div>
                </div>

                <div onclick="goToSlide(10)" class="card p-4 cursor-pointer hover:border-blue-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm">08</span>
                    <div>
                        <div class="text-sm font-bold text-white">Interactive Feature Slider</div>
                        <div class="text-xs text-slate-400">Live screenshot showcase & cloud URL</div>
                    </div>
                </div>

                <div onclick="goToSlide(11)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">09</span>
                    <div>
                        <div class="text-sm font-bold text-white">Social Impact & Metrics</div>
                        <div class="text-xs text-slate-400">Meals rescued, zero-waste CO2 reduction</div>
                    </div>
                </div>

                <div onclick="goToSlide(12)" class="card p-4 cursor-pointer hover:border-amber-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm">10</span>
                    <div>
                        <div class="text-sm font-bold text-white">Future Scope & Roadmap</div>
                        <div class="text-xs text-slate-400">Mobile apps, GPS van tracking & smart IoT</div>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 3: THE HARSH REALITY — HUNGER & SURVIVAL IN PAKISTAN
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-3">
        <div class="max-w-5xl mx-auto w-full">
            
            <div class="text-center mb-6">
                <span class="text-xs font-bold text-rose-400 uppercase tracking-widest">Section 01 • The Problem</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">Hunger & Survival in Pakistan</h2>
                <p class="text-slate-400 text-sm mt-0.5">36% Food Wasted vs. Millions Struggling for Daily Survival</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center mb-6">
                
                <!-- Left: Real imagery & Video Player Section -->
                <div class="card p-4 border-rose-500/30 overflow-hidden relative group">
                    <div class="relative h-56 rounded-xl overflow-hidden mb-3">
                        <img src="/food_wastage.png" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Food Wastage Crisis">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent flex flex-col justify-end p-4">
                            <span class="text-rose-400 text-xs font-bold uppercase tracking-wider">Documentary Evidence</span>
                            <h4 class="text-white text-base font-bold">Commercial Waste vs. Starvation</h4>
                        </div>
                        <!-- Play Video Button (Actionable Modal trigger) -->
                        <button onclick="toggleVideoModal(true)" class="absolute inset-0 m-auto w-14 h-14 rounded-full bg-rose-600/90 text-white flex items-center justify-center text-xl shadow-2xl hover:scale-110 transition-transform cursor-pointer" title="Watch Documentary Clip">
                            <i class="fas fa-play ml-1"></i>
                        </button>
                    </div>
                    <div class="flex items-center justify-between text-xs text-slate-400 px-1">
                        <span>📹 Click to watch documentary clip</span>
                        <span class="text-rose-400 font-bold">36 Million Tons Wasted</span>
                    </div>
                </div>

                <!-- Right: Emotional Statistics & Survival Facts -->
                <div class="space-y-3.5">
                    <div class="card card-rose p-4">
                        <div class="flex items-center gap-3">
                            <span class="text-3xl">😢</span>
                            <div>
                                <h4 class="text-white font-bold text-sm">Acute Hunger & Child Malnutrition</h4>
                                <p class="text-xs text-slate-300 leading-relaxed mt-0.5">
                                    Over 20+ million people in Pakistan face daily hunger. 40% of children suffer from stunted growth due to lack of basic daily nutrition.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card card-amber p-4">
                        <div class="flex items-center gap-3">
                            <span class="text-3xl">🗑️</span>
                            <div>
                                <h4 class="text-white font-bold text-sm">Banquet & Restaurant Discard</h4>
                                <p class="text-xs text-slate-300 leading-relaxed mt-0.5">
                                    Wedding banquets and restaurants throw away tons of safe, fresh meals every night simply because they have no collection mechanism.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card card-emerald p-4">
                        <div class="flex items-center gap-3">
                            <span class="text-3xl">💡</span>
                            <div>
                                <h4 class="text-white font-bold text-sm">The Solution Needed</h4>
                                <p class="text-xs text-slate-300 leading-relaxed mt-0.5">
                                    Not more food, but a <strong class="text-white">smart digital connection</strong> to redirect surplus meals before they enter the dumpster!
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 4: HOW FOOD IS PROVIDED (THE RELIEF PIPELINE)
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-4">
        <div class="max-w-5xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Section 02 • Distribution Flow</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">How Food is Provided to the Needy</h2>
                <p class="text-slate-400 text-sm mt-1">From commercial kitchens directly to shelter dastarkhwans</p>
            </div>

            <!-- 4 Stage Visual Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
                
                <!-- Stage 1 -->
                <div class="card p-5 border-emerald-500/30 text-center">
                    <div class="h-28 rounded-xl overflow-hidden mb-3">
                        <img src="/restaurant_bg.png" class="w-full h-full object-cover" alt="Restaurant Kitchen">
                    </div>
                    <span class="text-[10px] font-black uppercase text-emerald-400 block mb-1">Stage 01</span>
                    <h4 class="text-sm font-bold text-white mb-1">Surplus Logged</h4>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Restaurant chef enters remaining servings and expiry timeline into ShareMeal in 60s.
                    </p>
                </div>

                <!-- Stage 2 -->
                <div class="card p-5 border-blue-500/30 text-center">
                    <div class="h-28 rounded-xl overflow-hidden mb-3">
                        <img src="/charity_hero_premium.png" class="w-full h-full object-cover" alt="NGO Notification">
                    </div>
                    <span class="text-[10px] font-black uppercase text-blue-400 block mb-1">Stage 02</span>
                    <h4 class="text-sm font-bold text-white mb-1">Real-Time Claim</h4>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Nearby registered charities receive alerts, browse marketplace, and claim the donation.
                    </p>
                </div>

                <!-- Stage 3 -->
                <div class="card p-5 border-purple-500/30 text-center">
                    <div class="h-28 rounded-xl overflow-hidden mb-3">
                        <img src="/charity_volunteers.png" class="w-full h-full object-cover" alt="Food Packaging">
                    </div>
                    <span class="text-[10px] font-black uppercase text-purple-400 block mb-1">Stage 03</span>
                    <h4 class="text-sm font-bold text-white mb-1">Hygiene Pickup</h4>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Volunteers collect hygienically sealed containers following strict temperature standards.
                    </p>
                </div>

                <!-- Stage 4 -->
                <div class="card p-5 border-amber-500/30 text-center">
                    <div class="h-28 rounded-xl overflow-hidden mb-3">
                        <img src="/food_serving.png" class="w-full h-full object-cover" alt="Dignified Distribution">
                    </div>
                    <span class="text-[10px] font-black uppercase text-amber-400 block mb-1">Stage 04</span>
                    <h4 class="text-sm font-bold text-white mb-1">Dignified Serving</h4>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Meals distributed fresh to orphanages, slum families, and hospital waiting rooms.
                    </p>
                </div>

            </div>

            <!-- Target Beneficiaries -->
            <div class="card p-4 border-white/10 bg-slate-900/60 flex flex-wrap items-center justify-between gap-4 text-xs">
                <span class="text-amber-400 font-bold uppercase tracking-wider">Who Receives The Meals?</span>
                <span class="text-slate-300">✓ Orphanages</span>
                <span class="text-slate-300">✓ Old Age Homes</span>
                <span class="text-slate-300">✓ Labor Points</span>
                <span class="text-slate-300">✓ Slum Settlements</span>
                <span class="text-slate-300">✓ Hospital Patient Attendants</span>
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 5: SHAREMEAL SOLUTION
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-5">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Section 03 • Proposed System</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">The ShareMeal Ecosystem</h2>
                <p class="text-slate-400 text-sm mt-1">Comprehensive Web-Based Redistribution System</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
