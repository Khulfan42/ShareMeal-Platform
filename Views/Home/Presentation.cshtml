@{
    Layout = null;
    ViewData["Title"] = "ShareMeal - Final Year Project Presentation";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShareMeal Platform — FYP Final Defense Presentation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap');
        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: #090d16; 
            color: #f1f5f9; 
            overflow: hidden; 
            user-select: none;
        }

        h1, h2, h3, h4, .title-font {
            font-family: 'Outfit', sans-serif;
        }

        /* Slide Transitions */
        .slide { 
            display: none; 
            width: 100vw; 
            height: 100vh; 
            position: absolute; 
            top: 0; 
            left: 0; 
            opacity: 0; 
            transform: scale(0.98);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .slide.active { 
            display: flex; 
            opacity: 1; 
            transform: scale(1);
        }

        /* Clean animations */
        .anim-item {
            opacity: 0;
            transform: translateY(16px);
            animation: slideUp 0.5s ease forwards;
        }
        .anim-item:nth-child(1) { animation-delay: 0.1s; }
        .anim-item:nth-child(2) { animation-delay: 0.2s; }
        .anim-item:nth-child(3) { animation-delay: 0.3s; }
        .anim-item:nth-child(4) { animation-delay: 0.4s; }
        .anim-item:nth-child(5) { animation-delay: 0.5s; }

        @@keyframes slideUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Glass Cards */
        .card {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px);
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        .card:hover {
            border-color: rgba(16, 185, 129, 0.3);
            transform: translateY(-3px);
        }

        .card-emerald {
            background: rgba(6, 78, 59, 0.25);
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        /* Carousel inside presentation */
        .slider-img {
            display: none;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
        }
        .slider-img.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Controls */
        .nav-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .nav-btn:hover {
            background: #10b981;
            color: #090d16;
            border-color: #10b981;
            transform: scale(1.08);
        }

        .progress-line {
            position: fixed;
            bottom: 0;
            left: 0;
            height: 4px;
            background: #10b981;
            transition: width 0.3s ease;
            z-index: 50;
        }

        .badge-academic {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
        }
    </style>
</head>
<body>

    <!-- ── TOP BAR (Clean, discreet & academic) ────────────────────── -->
    <header class="fixed top-0 left-0 right-0 z-50 px-6 py-4 flex items-center justify-between pointer-events-none">
        <!-- Return Link -->
        <a href="/" class="nav-btn pointer-events-auto" title="Return to Website">
            <i class="fas fa-arrow-left text-sm"></i>
        </a>

        <!-- Academic Header Tag -->
        <div class="px-4 py-1.5 rounded-full card text-xs font-semibold text-slate-300 flex items-center gap-2 pointer-events-auto border border-white/10 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Final Year Project (FYP)</span>
            <span class="text-slate-600">•</span>
            <span>University of Southern Punjab, Multan</span>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 pointer-events-auto">
            <!-- Table of contents button -->
            <button onclick="goToSlide(2)" class="px-3.5 py-2 rounded-full card hover:border-emerald-400 text-xs font-semibold text-slate-200 transition-all flex items-center gap-1.5" title="Go to Agenda">
                <i class="fas fa-list text-emerald-400"></i>
                <span>Agenda</span>
            </button>

            <!-- Direct PPTX Download -->
            <a href="/Home/DownloadPresentation" class="px-4 py-2 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/20" title="Download PowerPoint File (.pptx)">
                <i class="fas fa-file-powerpoint"></i>
                <span>Download PPTX</span>
            </a>

            <!-- Fullscreen -->
            <button onclick="toggleFullscreen()" class="nav-btn" title="Toggle Fullscreen (F)">
                <i class="fas fa-expand text-sm"></i>
            </button>
        </div>
    </header>

    <!-- Side Navigation Arrows -->
    <button class="nav-btn fixed left-5 top-1/2 -translate-y-1/2 z-40" onclick="changeSlide(-1)" id="prevBtn" title="Previous Slide (←)">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button class="nav-btn fixed right-5 top-1/2 -translate-y-1/2 z-40" onclick="changeSlide(1)" id="nextBtn" title="Next Slide (→)">
        <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Progress & Slide Indicator -->
    <div class="progress-line" id="progressBar"></div>
    <div class="fixed bottom-4 right-6 text-xs font-bold text-slate-400 font-mono z-40" id="slideCounter">
        01 / 11
    </div>
    <div class="fixed bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-slate-500 font-medium tracking-wide z-40">
        Use Arrow Keys [← →] or Spacebar to Navigate
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 1: FORMAL TITLE SLIDE
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide active flex-col items-center justify-center text-center px-6" id="slide-1">
        <div class="max-w-4xl mx-auto w-full">
            
            <!-- University Name & Department -->
            <div class="anim-item inline-flex items-center gap-2 px-4 py-1.5 rounded-full badge-academic text-xs font-bold uppercase tracking-wider mb-6">
                <span>🏛️</span> Department of Computer Science • University of Southern Punjab, Multan
            </div>

            <!-- Project Title -->
            <h1 class="anim-item text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-4">
                ShareMeal <span class="text-emerald-400">Platform</span>
            </h1>

            <!-- Subtitle -->
            <p class="anim-item text-base sm:text-xl text-slate-300 font-medium max-w-2xl mx-auto mb-10 leading-relaxed">
                A Web-Based Surplus Food Redistribution & Zero-Hunger Management System
            </p>

            <!-- Formal Defense Details Grid -->
            <div class="anim-item grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto text-left mb-8">
                <!-- Presented By -->
                <div class="card p-5 border-emerald-500/30">
                    <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 block mb-1">Presented By</span>
                    <h3 class="text-lg font-bold text-white mb-0.5">Muhammad Khulfan</h3>
                    <h3 class="text-lg font-bold text-white mb-2">Abdullah Khalid</h3>
                    <p class="text-xs text-slate-400">BS Computer Science (BSCS) • Final Year Project</p>
                </div>

                <!-- Supervised By -->
                <div class="card p-5 border-amber-500/30">
                    <span class="text-[10px] font-black uppercase tracking-widest text-amber-400 block mb-1">Supervised By</span>
                    <h3 class="text-xl font-bold text-white mb-1">Prof. Kinat</h3>
                    <p class="text-xs text-slate-400 mt-2">Department of Computer Science</p>
                    <p class="text-xs text-amber-400/90 font-medium">Faculty of Computing & IT</p>
                </div>
            </div>

            <div class="anim-item text-xs text-slate-500 font-medium">
                Academic Session 2022–2026 • Final Project Defense
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 2: PRESENTATION OUTLINE / AGENDA
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-2">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Presentation Roadmap</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">Table of Contents</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div onclick="goToSlide(3)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">01</span>
                    <div>
                        <div class="text-sm font-bold text-white">Problem Statement</div>
                        <div class="text-xs text-slate-400">The food wastage & hunger crisis in Pakistan</div>
                    </div>
                </div>

                <div onclick="goToSlide(4)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">02</span>
                    <div>
                        <div class="text-sm font-bold text-white">Proposed Solution</div>
                        <div class="text-xs text-slate-400">How ShareMeal connects donors with charities</div>
                    </div>
                </div>

                <div onclick="goToSlide(5)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">03</span>
                    <div>
                        <div class="text-sm font-bold text-white">System Architecture</div>
                        <div class="text-xs text-slate-400">MVC pattern, data flow & security layers</div>
                    </div>
                </div>

                <div onclick="goToSlide(6)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">04</span>
                    <div>
                        <div class="text-sm font-bold text-white">Core User Roles</div>
                        <div class="text-xs text-slate-400">Restaurant, Charity and Admin workflows</div>
                    </div>
                </div>

                <div onclick="goToSlide(7)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">05</span>
                    <div>
                        <div class="text-sm font-bold text-white">Technology Stack</div>
                        <div class="text-xs text-slate-400">ASP.NET Core 8, C#, Tailwind CSS & SQLite</div>
                    </div>
                </div>

                <div onclick="goToSlide(8)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">06</span>
                    <div>
                        <div class="text-sm font-bold text-white">AI Assistant (MealBot)</div>
                        <div class="text-xs text-slate-400">Google Gemini 2.0 Flash + Web Speech Voice</div>
                    </div>
                </div>

                <div onclick="goToSlide(9)" class="card p-4 cursor-pointer hover:border-emerald-400 flex items-center gap-4 sm:col-span-2 max-w-md mx-auto w-full">
                    <span class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">07</span>
                    <div>
                        <div class="text-sm font-bold text-white">Live Platform Demonstration & Slider</div>
                        <div class="text-xs text-slate-400">Interactive UI screenshots & live cloud URL</div>
                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 3: PROBLEM STATEMENT
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-3">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-rose-400 uppercase tracking-widest">Section 01</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">The Problem in Pakistan</h2>
                <p class="text-slate-400 text-sm mt-1">Food Wastage vs. Widespread Hunger Crisis</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                <div class="card p-6 border-rose-500/30 text-center">
                    <div class="text-4xl mb-3">🗑️</div>
                    <div class="text-3xl font-black text-rose-400 mb-1">36%</div>
                    <div class="text-sm font-bold text-white mb-2">Food Produced is Wasted</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Millions of tons of edible meals are discarded annually by restaurants, banquets, and hotels.
                    </p>
                </div>

                <div class="card p-6 border-amber-500/30 text-center">
                    <div class="text-4xl mb-3">💔</div>
                    <div class="text-3xl font-black text-amber-400 mb-1">20M+</div>
                    <div class="text-sm font-bold text-white mb-2">People Face Hunger</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Underprivileged families and orphanages struggle daily for basic nutritional sustenance.
                    </p>
                </div>

                <div class="card p-6 border-blue-500/30 text-center">
                    <div class="text-4xl mb-3">🔌</div>
                    <div class="text-3xl font-black text-blue-400 mb-1">No Bridge</div>
                    <div class="text-sm font-bold text-white mb-2">Communication Gap</div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Donors have food but no pickup partner. Charities need food but have no real-time notification.
                    </p>
                </div>
            </div>

            <div class="card p-4 text-center border-emerald-500/40 bg-emerald-950/20">
                <p class="text-sm text-slate-200">
                    <strong class="text-emerald-400">Core Objective:</strong> Build a simple, trustworthy digital platform to turn surplus food into timely hunger relief.
                </p>
            </div>

        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         SLIDE 4: PROPOSED SOLUTION
    ═══════════════════════════════════════════════════════════ -->
    <div class="slide flex-col items-center justify-center px-6" id="slide-4">
        <div class="max-w-4xl mx-auto w-full">
            
            <div class="text-center mb-8">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Section 02</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">Proposed Solution: ShareMeal</h2>
                <p class="text-slate-400 text-sm mt-1">How our platform solves the problem</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
