<!-- ─── PRESENTATION ENGINE JAVASCRIPT ──────────────────────── -->
<script>
    let currentSlide = 1;
    const totalSlides = 13;

    function showSlide(n) {
        const slides = document.querySelectorAll('.slide');
        slides.forEach(s => { 
            s.style.display = 'none'; 
            s.classList.remove('active'); 
        });

        currentSlide = Math.max(1, Math.min(n, totalSlides));

        const active = document.getElementById('slide-' + currentSlide);
        if (active) {
            active.style.display = 'flex';
            active.classList.add('active');

            // Trigger animations
            active.querySelectorAll('[class*="fade-up"],[class*="slide-left"],[class*="slide-right"],[class*="scale-in"]').forEach(el => {
                el.style.animation = 'none';
                el.offsetHeight; // reflow
                el.style.animation = '';
            });
        }

        // Progress bar
        const pct = (currentSlide / totalSlides) * 100;
        document.getElementById('progressBar').style.width = pct + '%';

        // Counter
        const num = currentSlide.toString().padStart(2, '0');
        const tot = totalSlides.toString().padStart(2, '0');
        document.getElementById('slideCounter').textContent = num + ' / ' + tot;

        // Render chart if slide 10
        if (currentSlide === 10) {
            initImpactChart();
        }
    }

    function changeSlide(dir) {
        showSlide(currentSlide + dir);
    }

    function goToSlide(n) {
        showSlide(n);
    }

    // Keyboard bindings
    document.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
            e.preventDefault();
            changeSlide(1);
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
            e.preventDefault();
            changeSlide(-1);
        } else if (e.key === 'Home') {
            e.preventDefault();
            goToSlide(1);
        } else if (e.key === 'End') {
            e.preventDefault();
            goToSlide(totalSlides);
        } else if (e.key === 'f' || e.key === 'F') {
            toggleFullscreen();
        } else if (e.key === 'Escape') {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            }
        }
    });

    // Fullscreen helper
    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => {
                console.log("Fullscreen request failed", err);
            });
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }

    // Chart.js initialization for Slide 10
    let chartRendered = false;
    function initImpactChart() {
        if (chartRendered) return;
        const ctx = document.getElementById('impactChart');
        if (!ctx) return;
        chartRendered = true;

        new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Meals Rescued', 'Partner Charities', 'Participating Restaurants', 'AI Interactions'],
                datasets: [{
                    data: [500, 32, 28, 1200],
                    backgroundColor: ['#10b981', '#38bdf8', '#c084fc', '#f59e0b'],
                    borderWidth: 0,
                    hoverOffset: 12
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: 'rgba(255,255,255,0.7)',
                            padding: 14,
                            font: { size: 11, weight: '600', family: 'Plus Jakarta Sans' }
                        }
                    }
                },
                animation: {
                    duration: 1200,
                    easing: 'easeOutQuart'
                }
            }
        });
    }

    // Start presentation on Slide 1
    showSlide(1);
</script>

