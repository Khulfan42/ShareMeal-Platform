    <!-- ═══════════════════════════════════════════════════════════
         DOCUMENTARY VIDEO MODAL (Interactive Action)
    ═══════════════════════════════════════════════════════════ -->
    <div id="videoModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="relative w-full max-w-4xl bg-slate-900 rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
            <!-- Modal Header -->
            <div class="px-6 py-4 flex items-center justify-between border-b border-white/10">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-rose-500"></span>
                    <span class="text-sm font-bold text-white">Documentary Reality: Food Wastage vs. Hunger in Pakistan</span>
                </div>
                <button onclick="toggleVideoModal(false)" class="w-8 h-8 rounded-full card hover:bg-rose-500 text-white flex items-center justify-center text-xs">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <!-- Video Player (Clean embed) -->
            <div class="relative w-full" style="padding-top: 56.25%;">
                <iframe id="videoIframe" class="absolute inset-0 w-full h-full" 
                        src="https://www.youtube.com/embed/5U_Z2L1h-Xk?enablejsapi=1" 
                        title="Food Insecurity and Hunger Crisis in Pakistan" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                </iframe>
            </div>
            <div class="p-4 bg-slate-950 flex items-center justify-between text-xs text-slate-400">
                <span>Ref: Saylani & Edhi Hunger Relief Data • ShareMeal Initiative</span>
                <button onclick="toggleVideoModal(false)" class="px-4 py-1.5 rounded-lg card text-white text-xs hover:border-emerald-400">
                    Close Video
                </button>
            </div>
        </div>
    </div>


    <!-- ── JAVASCRIPT ENGINE ──────────────────────────────────────── -->
    <script>
        let currentSlide = 1;
        const totalSlides = 13;

        function showSlide(n) {
            const slides = document.querySelectorAll('.slide');
            slides.forEach(s => {
                s.style.display = 'none';
                s.classList.remove('active');
            });

            currentSlide = Math.max(1, Math.min(n, totalSlides));

            const active = document.getElementById('slide-' + currentSlide);
            if (active) {
                active.style.display = 'flex';
                active.classList.add('active');

                // Trigger animations
                active.querySelectorAll('.anim-item').forEach(el => {
                    el.style.animation = 'none';
                    el.offsetHeight; // force reflow
                    el.style.animation = '';
                });
            }

            // Progress bar update
            const pct = (currentSlide / totalSlides) * 100;
            document.getElementById('progressBar').style.width = pct + '%';

            // Counter
            const num = currentSlide.toString().padStart(2, '0');
            const tot = totalSlides.toString().padStart(2, '0');
            document.getElementById('slideCounter').textContent = num + ' / ' + tot;
        }

        function changeSlide(dir) {
            showSlide(currentSlide + dir);
        }

        function goToSlide(n) {
            showSlide(n);
        }

        // Keyboard listeners
        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
                e.preventDefault();
                changeSlide(1);
            } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
                e.preventDefault();
                changeSlide(-1);
            } else if (e.key === 'Home') {
                e.preventDefault();
                goToSlide(1);
            } else if (e.key === 'End') {
                e.preventDefault();
                goToSlide(totalSlides);
            } else if (e.key === 'f' || e.key === 'F') {
                toggleFullscreen();
            } else if (e.key === 'Escape') {
                toggleVideoModal(false);
            }
        });

        // Fullscreen Toggle
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.log("Fullscreen request failed", err);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        // Video Modal Handler
        function toggleVideoModal(show) {
            const modal = document.getElementById('videoModal');
            const iframe = document.getElementById('videoIframe');
            if (show) {
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
                // Stop video by resetting src
                const src = iframe.src;
                iframe.src = src;
            }
        }

        // Demo Screenshot Slider (Slide 10)
        let currentDemoImg = 1;
        const totalDemoImgs = 4;
        const captions = [
            "1. Home & Zero-Waste Mission",
            "2. Community Food Distribution",
            "3. Fresh Produce & Surplus Management",
            "4. Charity Registration & Verification"
        ];

        function showDemoImage(n) {
            currentDemoImg = Math.max(1, Math.min(n, totalDemoImgs));
            for (let i = 1; i <= totalDemoImgs; i++) {
                const img = document.getElementById('demo-slide-' + i);
                if (img) img.classList.remove('active');
            }
            const activeImg = document.getElementById('demo-slide-' + currentDemoImg);
            if (activeImg) activeImg.classList.add('active');

            const cap = document.getElementById('sliderCaption');
            if (cap) cap.textContent = captions[currentDemoImg - 1];
        }

        function nextDemoImage() {
            let next = currentDemoImg + 1;
            if (next > totalDemoImgs) next = 1;
            showDemoImage(next);
        }

        function prevDemoImage() {
            let prev = currentDemoImg - 1;
            if (prev < 1) prev = totalDemoImgs;
            showDemoImage(prev);
        }

        // Auto-cycle demo screenshots every 4.5 seconds on slide 10
        setInterval(() => {
            if (currentSlide === 10) {
                nextDemoImage();
            }
        }, 4500);

        // Init
        showSlide(1);
    </script>
</body>
</html>
