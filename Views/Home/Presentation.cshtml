    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;width:100%;max-width:1150px;">
        <div class="glass-emerald feature-card p-6 rounded-3xl border border-emerald-500/30 text-center">
            <div class="text-4xl mb-3">🍽️</div>
            <div class="text-base font-extrabold text-white mb-1">Restaurant Portal</div>
            <div class="text-xs font-bold text-emerald-400 mb-3">Food Donors</div>
            <div class="text-xs text-slate-400 leading-relaxed">Post surplus meal details in 30 seconds. Track collection, set expiry times, and view donation history.</div>
        </div>
