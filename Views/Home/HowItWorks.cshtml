@{
    ViewData["Title"] = "How It Works";
    ViewData["BackgroundImage"] = "/hero_slider_1.png";
}

<div class="relative min-h-screen pt-32 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
            <span class="inline-flex items-center gap-2 bg-blue-500/10 text-blue-400 px-4 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-8 border border-blue-500/20">
                ⚡ Simple 3-Step Process
            </span>
            <h1 class="text-5xl md:text-7xl font-black outfit text-white leading-tight tracking-tighter">
                From Plate to <span class="text-blue-500">People.</span>
            </h1>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <div class="backdrop-blur-3xl bg-white/5 p-10 rounded-[3rem] border border-white/5 relative overflow-hidden group hover:border-blue-500 transition-all">
                <div class="text-5xl mb-8 group-hover:scale-110 transition-transform">🏘️</div>
                <h3 class="text-2xl font-black text-white outfit mb-4 uppercase tracking-widest">1. Register</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Join as a verified Restaurant or Charity partner through our secure platform.</p>
                <div class="mt-8 text-blue-400 font-black text-[10px] uppercase tracking-widest">Setup in minutes →</div>
            </div>

            <div class="backdrop-blur-3xl bg-white/5 p-10 rounded-[3rem] border border-white/5 relative overflow-hidden group hover:border-emerald-500 transition-all">
                <div class="text-5xl mb-8 group-hover:scale-110 transition-transform">🥗</div>
                <h3 class="text-2xl font-black text-white outfit mb-4 uppercase tracking-widest">2. List/Claim</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Restaurants post surplus; Charities view and claim food in a real-time marketplace feed.</p>
                <div class="mt-8 text-emerald-400 font-black text-[10px] uppercase tracking-widest">Real-time sync →</div>
            </div>

            <div class="backdrop-blur-3xl bg-white/5 p-10 rounded-[3rem] border border-white/5 relative overflow-hidden group hover:border-amber-500 transition-all">
                <div class="text-5xl mb-8 group-hover:scale-110 transition-transform">🚚</div>
                <h3 class="text-2xl font-black text-white outfit mb-4 uppercase tracking-widest">3. Pickup</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Coordinate logistics and complete the handover at the restaurant's location.</p>
                <div class="mt-8 text-amber-400 font-black text-[10px] uppercase tracking-widest">Zero latency →</div>
            </div>
        </div>
    </div>
</div>
