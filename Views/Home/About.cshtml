@{
    ViewData["Title"] = "Our Mission";
    ViewData["BackgroundImage"] = "/charity_hero_premium.png";
}

<div class="relative min-h-screen pt-32 pb-20 px-6">
    <div class="max-w-4xl mx-auto backdrop-blur-3xl bg-white/5 p-12 rounded-[3.5rem] border border-white/5 relative overflow-hidden shadow-2xl">
        <div class="relative z-10">
            <span class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-400 px-4 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-8 border border-emerald-500/20">
                🌍 Global Impact
            </span>
            <h1 class="text-5xl font-black outfit text-white leading-tight mb-8">
                Turning Surplus into <br><span class="text-emerald-500">Nourishment.</span>
            </h1>
            
            <div class="prose prose-invert max-w-none text-slate-300 text-lg leading-relaxed space-y-10">
                <!-- Our Mission -->
                <div>
                    <h3 class="text-white font-black text-xl uppercase tracking-widest mb-4">Our Mission</h3>
                    <p>
                        ShareMeal was founded to solve a critical global paradox: **Millions of tons of fresh, high-quality food are wasted every day, while millions of people go to sleep hungry.** Our mission is to eliminate this gap by building a real-time, digital bridge that connects surplus-producing restaurants with verified charitable organizations.
                    </p>
                </div>

                <!-- Our Vision -->
                <div>
                    <h3 class="text-white font-black text-xl uppercase tracking-widest mb-4">Our Vision</h3>
                    <p>
                        We envision a world where **Zero Waste leads to Zero Hunger**. By leveraging technology to streamline logistics and promote community transparency, we aim to transform local food redistribution into a seamless, daily habit for every modern city.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
                    <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-emerald-500/50 transition-all">
                        <h4 class="text-emerald-400 font-black mb-3 uppercase tracking-widest text-sm">For Restaurants</h4>
                        <p class="text-xs text-slate-400">Stop the waste. Seamlessly list surplus inventory and ensure it reaches registered NGOs within minutes before it loses freshness.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-blue-500/50 transition-all">
                        <h4 class="text-blue-400 font-black mb-3 uppercase tracking-widest text-sm">For Charities</h4>
                        <p class="text-xs text-slate-400">Access a real-time feed of available food donations and coordinate fast, reliable pickups to feed the needy instantly.</p>
                    </div>
                </div>

                <div class="text-center pt-8">
                    <p class="text-slate-500 text-[10px] font-black uppercase tracking-[0.4em]">Together, We Can Save Lives</p>
                </div>
            </div>
        </div>
    </div>
</div>
