@{
    ViewData["Title"] = "Contact Us";
    ViewData["BackgroundImage"] = "/food_wastage.png";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-16">
        <h1 class="text-4xl font-black text-white sm:text-5xl">Get in <span class="text-emerald-400">Touch</span></h1>
        <p class="mt-4 text-lg text-slate-400">Have questions about joining as a restaurant or NGO? Drop us a message.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-slate-800/40 border border-slate-700 rounded-3xl p-8 md:p-12 shadow-2xl backdrop-blur-sm">
        
        <!-- Contact Info -->
        <div>
            <h2 class="text-2xl font-bold text-white mb-6">Contact Information</h2>
            <p class="text-slate-400 mb-8">Ready to reduce food waste in your community? Connect with our administration team for onboarding assistance.</p>
            
            <div class="space-y-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-slate-700/50 rounded-full flex items-center justify-center mr-4 text-emerald-400">
                        <!-- mail icon -->
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-bold uppercase tracking-wider">Email Support</p>
                        <p class="text-white">mkhulfan@gmail.com</p>
                    </div>
                </div>

                <div class="flex items-center">
                    <div class="w-12 h-12 bg-slate-700/50 rounded-full flex items-center justify-center mr-4 text-emerald-400">
                        <!-- phone icon -->
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-bold uppercase tracking-wider">Phone Support</p>
                        <p class="text-white">+92 303 7377365</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div>
            @if (Context.Request.Query["success"] == "true")
            {
                <div class="bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 p-4 rounded-xl mb-6 flex items-center shadow-[0_0_15px_rgba(16,185,129,0.2)]">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Thank you! Your message has been sent successfully. We will get back to you soon.</span>
                </div>
            }

            <form asp-action="Contact" asp-controller="Home" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Full Name</label>
                    <input type="text" name="FullName" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="John Doe" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Email Address</label>
                    <input type="email" name="Email" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="john@example.com" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Message</label>
                    <textarea rows="4" name="Message" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="How can we help?" required></textarea>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition-transform hover:scale-105 active:scale-95">
                    Send Message
                </button>
            </form>
        </div>

    </div>
</div>
