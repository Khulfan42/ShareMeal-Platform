@{
    ViewData["Title"] = "Design Theory";
    ViewData["BackgroundImage"] = "/carousel_3.png";
}

<div class="relative min-h-screen bg-slate-950 pt-32 pb-20 px-6">
    <div class="max-w-4xl mx-auto backdrop-blur-3xl bg-white/5 p-12 rounded-[3.5rem] border border-white/5 relative overflow-hidden shadow-2xl">
        <!-- Decoration -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -mr-32 -mt-32"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-amber-500/10 rounded-full blur-[80px] -ml-32 -mb-32"></div>

        <div class="relative z-10">
            <div class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-400 px-4 py-2 rounded-full text-[10px] font-black tracking-widest uppercase mb-8 border border-emerald-500/20">
                📚 Documentation Theory
            </div>
            
            <h1 class="text-5xl font-black outfit text-white leading-tight mb-8">
                Visual & Philosophical <br><span class="text-emerald-500">Design Approach.</span>
            </h1>
            
            <div class="prose prose-invert max-w-none space-y-12 text-slate-300 leading-relaxed">
                
                <section>
                    <h2 class="text-2xl font-black text-white mb-6 border-l-4 border-emerald-500 pl-6">1. Frontend Design Philosophy</h2>
                    <p class="text-lg">
                        The frontend of <strong>ShareMeal</strong> is architected of High-Contrast Dark Aesthetics. In a food redistribution system, cleanliness, reliability, and speed are expressed through deep-space backgrounds and vibrant accent colors, ensuring that technical complexity never hinders social action.
                    </p>
                </section>

                <section>
                    <h2 class="text-2xl font-black text-white mb-6 border-l-4 border-amber-500 pl-6">2. Cinematic Visual Strategy</h2>
                    <p class="text-lg">
                        We use high-fidelity video backgrounds and translucent glassmorphism to capture the emotional essence of the platform. By layering data over cinematic visuals, we provide a 360-degree view of the platform’s impact within seconds.
                    </p>
                </section>

                <section>
                    <h2 class="text-2xl font-black text-white mb-6 border-l-4 border-emerald-500 pl-6">3. Color Psychology</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
                        <div class="p-8 rounded-[2rem] bg-white/5 border border-white/5 flex items-center gap-6">
                            <div class="w-16 h-16 rounded-2xl bg-[#2ECC71] shadow-lg shadow-emerald-500/30"></div>
                            <div>
                                <h4 class="font-black text-white uppercase text-xs tracking-widest">Primary Green</h4>
                                <p class="text-slate-500 text-[10px] mt-1 uppercase tracking-widest">Sustainability</p>
                            </div>
                        </div>
                        <div class="p-8 rounded-[2rem] bg-white/5 border border-white/5 flex items-center gap-6">
                            <div class="w-16 h-16 rounded-2xl bg-[#F39C12] shadow-lg shadow-amber-500/30"></div>
                            <div>
                                <h4 class="font-black text-white uppercase text-xs tracking-widest">Secondary Orange</h4>
                                <p class="text-slate-500 text-[10px] mt-1 uppercase tracking-widest">Community Action</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
