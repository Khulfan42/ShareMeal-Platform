@using ShareMeal.Web.Models
@{
    ViewData["Title"] = "Account Status";
    var status = (OrganizationStatus)ViewBag.Status;
}

<div class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-slate-900/50 backdrop-blur-xl border border-slate-800 rounded-3xl p-8 text-center shadow-2xl">
        <div class="mb-6 inline-flex p-4 rounded-full @(status == OrganizationStatus.Suspended ? "bg-red-500/10 text-red-500" : "bg-amber-500/10 text-amber-500")">
            @if (status == OrganizationStatus.Suspended)
            {
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            }
            else if (status == OrganizationStatus.Pending)
            {
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            }
            else
            {
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            }
        </div>

        <h1 class="text-3xl font-bold text-white mb-4">
            @if (status == OrganizationStatus.Suspended) { <text>Account Suspended</text> }
            else if (status == OrganizationStatus.Pending) { <text>Verification Pending</text> }
            else { <text>Access Restricted</text> }
        </h1>

        <p class="text-slate-400 mb-8 leading-relaxed">
            @if (status == OrganizationStatus.Suspended)
            {
                <text>Your organization account has been suspended by the administrator. Please contact support for more information or to appeal this decision.</text>
            }
            else if (status == OrganizationStatus.Pending)
            {
                <text>Thank you for joining ShareMeal! Your organization details are currently being reviewed by our admin team. You will have full access once verified.</text>
            }
            else if (status == OrganizationStatus.Rejected)
            {
                <text>Your organization application was not approved at this time. If you believe this is a mistake, please reach out to our team.</text>
            }
        </p>

        <div class="space-y-3">
            <a href="/" class="block w-full py-4 px-6 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-2xl transition-all shadow-lg shadow-emerald-500/20">
                Back to Home
            </a>
            
            <div class="grid grid-cols-2 gap-3">
                <a href="https://wa.me/923037377365" target="_blank" class="flex items-center justify-center gap-2 py-4 px-4 bg-[#25D366] hover:bg-[#20bd5c] text-white font-semibold rounded-2xl transition-all shadow-lg shadow-emerald-500/10">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    WhatsApp
                </a>
                <a href="mailto:mkhulfan9@gmail.com" class="flex items-center justify-center gap-2 py-4 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-2xl transition-all border border-slate-700">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Email
                </a>
            </div>
            
            <form class="inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="mt-4 text-slate-500 hover:text-white text-sm transition-colors">
                    Log out and try another account
                </button>
            </form>
        </div>
    </div>
</div>
