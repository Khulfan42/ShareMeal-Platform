@{
    ViewData["Title"] = "Developer Profile";
    ViewData["BackgroundImage"] = "/carousel_1.png";
}

<style>
    .blink-animation {
        animation: pulse-glow 2s infinite;
    }
    @@keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(29, 185, 84, 0.7); }
        70% { box-shadow: 0 0 0 20px rgba(29, 185, 84, 0); }
        100% { box-shadow: 0 0 0 0 rgba(29, 185, 84, 0); }
    }
</style>

<div class="min-h-[85vh] flex items-center justify-center p-4">
    <div class="w-full max-w-[450px] bg-[#111827]/60 backdrop-blur-3xl rounded-[40px] px-8 py-16 shadow-2xl border border-white/5 relative z-10 dev-card-glow">
        <!-- Glowing Image -->
        <div class="flex justify-center mb-6">
            <div class="relative w-36 h-36">
                <div class="absolute inset-0 bg-blue-500 rounded-full blur-[25px] opacity-40"></div>
                <img src="~/dev_pic.png" class="relative w-36 h-36 rounded-full border-2 border-blue-400 shadow-xl object-cover transform hover:scale-105 transition duration-300" alt="Choudhary Khulfan">
            </div>
        </div>

        <!-- Typography -->
        <h1 class="text-[32px] font-black text-white text-center mb-3 tracking-tight outfit">Choudhary Khulfan</h1>
        <p class="text-emerald-400 font-black text-center text-[10px] uppercase tracking-[0.3em] mb-2">Full Stack Architect</p>
        <p class="text-[#c084fc] font-medium text-center text-sm mb-10">iOS App | Android App | Website</p>
        
        <!-- Tags -->
        <div class="flex flex-wrap justify-center gap-3 mb-10">
            <span class="px-5 py-2.5 rounded-full border border-slate-700 bg-white/5 text-slate-400 text-[10px] font-black uppercase tracking-widest shadow-inner">Software Architect</span>
            <span class="px-5 py-2.5 rounded-full border border-slate-700 bg-white/5 text-slate-400 text-[10px] font-black uppercase tracking-widest shadow-inner">Premium UI/UX</span>
        </div>

        <!-- Bio -->
        <p class="text-slate-400 text-center text-sm leading-relaxed mb-12 px-2 font-medium">
            Expert in <span class="text-white font-bold">iOS, Android, & Web <br>Development</span>. Specializing in high-end<br>university projects, Final Year Projects (FYP),<br>and custom software solutions.
        </p>

        <!-- CTA Box -->
        <div class="bg-white/5 rounded-3xl p-6 border border-white/5 hover:border-emerald-500/50 transition-colors">
            <p class="text-[#c084fc] text-center font-black text-[10px] tracking-[0.2em] mb-4 uppercase">Paid Projects Only</p>
            <a href="https://wa.me/923037377365" target="_blank" class="blink-animation flex items-center justify-center w-full bg-[#1db954] hover:bg-[#1ed760] transition-all transform hover:scale-105 active:scale-95 text-white font-bold py-4 rounded-2xl shadow-[0_0_20px_rgba(29,185,84,0.3)]">
                WhatsApp: 03037377365
            </a>
        </div>
    </div>
</div>
