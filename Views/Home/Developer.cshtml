@{
    ViewData["Title"] = "Developer & Academic Team";
    ViewData["BackgroundImage"] = "/carousel_1.png";
}

<style>
    .dev-glow {
        box-shadow: 0 0 50px rgba(16, 185, 129, 0.15);
    }
</style>

<div class="min-h-[85vh] py-16 px-4 max-w-5xl mx-auto flex flex-col items-center justify-center">
    
    <!-- Academic Badge -->
    <div class="mb-6 inline-flex items-center gap-2 px-5 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-black uppercase tracking-widest shadow-lg">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Final Year Project (FYP) • BSCS 2026
    </div>

    <!-- Title -->
    <h1 class="text-3xl sm:text-5xl font-black text-white text-center mb-3 tracking-tight">
        Project <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">Engineering Team</span>
    </h1>
    <p class="text-slate-400 text-center text-sm max-w-2xl mx-auto mb-12 leading-relaxed">
        Department of Computer Science • <span class="text-white font-semibold">University of Southern Punjab (USP), Multan</span>
    </p>

    <!-- Supervisor Spotlight Card -->
    <div class="w-full bg-[#111827]/70 backdrop-blur-3xl rounded-[32px] p-8 border border-amber-500/30 shadow-2xl mb-8 relative overflow-hidden">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="w-20 h-20 rounded-2xl bg-amber-500/20 border-2 border-amber-400/40 flex items-center justify-center text-4xl shadow-xl">
                    👩‍🏫
                </div>
                <div>
                    <span class="text-[11px] font-black uppercase tracking-widest text-amber-400">Academic FYP Supervisor</span>
                    <h2 class="text-2xl font-black text-white mt-0.5">Prof. Kinat</h2>
                    <p class="text-slate-400 text-xs mt-1">Department of Computer Science • University of Southern Punjab, Multan</p>
                </div>
            </div>
            <div class="text-right sm:border-l sm:border-white/10 sm:pl-6">
                <span class="px-4 py-1.5 rounded-full bg-amber-500/10 text-amber-300 text-xs font-bold border border-amber-500/20">
                    Faculty of Computing & IT
                </span>
            </div>
        </div>
    </div>

    <!-- Developers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full mb-12">
        
        <!-- Muhammad Khulfan -->
        <div class="bg-[#111827]/70 backdrop-blur-3xl rounded-[36px] p-8 border border-emerald-500/30 shadow-2xl flex flex-col justify-between dev-glow relative">
            <div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="relative w-20 h-20">
                        <div class="absolute inset-0 bg-emerald-500 rounded-full blur-[20px] opacity-40"></div>
                        <img src="~/dev_pic.png" class="relative w-20 h-20 rounded-full border-2 border-emerald-400 shadow-xl object-cover" alt="Muhammad Khulfan">
                    </div>
                    <div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Lead Developer & Architect</span>
                        <h3 class="text-2xl font-black text-white">Muhammad Khulfan</h3>
                        <p class="text-cyan-400 font-medium text-xs">iOS Engineer • Full Stack .NET</p>
                    </div>
                </div>

                <p class="text-slate-400 text-xs leading-relaxed mb-6 font-medium">
                    Architected ShareMeal Platform from the ground up: created the database schema, designed the responsive UI, implemented Google Gemini AI integration, built Web Speech voice recording, and deployed to production cloud via Docker.
                </p>

                <div class="flex flex-wrap gap-2 mb-6">
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">ASP.NET Core 8</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">C# 12</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">iOS Swift</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">Gemini AI</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">Docker</span>
                </div>
            </div>

            <div class="pt-4 border-t border-white/10 text-[11px] text-slate-400 flex items-center justify-between">
                <span>BSCS • USP Multan</span>
                <span class="text-emerald-400 font-bold">Lead Project Engineer</span>
            </div>
        </div>

        <!-- Abdullah Khalid -->
        <div class="bg-[#111827]/70 backdrop-blur-3xl rounded-[36px] p-8 border border-purple-500/30 shadow-2xl flex flex-col justify-between relative">
            <div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-600 to-indigo-700 border-2 border-purple-400 shadow-xl flex items-center justify-center text-white font-black text-2xl">
                        AK
                    </div>
                    <div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-purple-400">Team Member & Developer</span>
                        <h3 class="text-2xl font-black text-white">Abdullah Khalid</h3>
                        <p class="text-purple-300 font-medium text-xs">BSCS Computer Science</p>
                    </div>
                </div>

                <p class="text-slate-400 text-xs leading-relaxed mb-6 font-medium">
                    Collaborated on the development, system analysis, module testing, and project documentation for ShareMeal Platform as an integral member of the Final Year Project team.
                </p>

                <div class="flex flex-wrap gap-2 mb-6">
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">BSCS</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">System Testing</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">Web Development</span>
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-slate-700 text-slate-300 text-[10px] font-bold">Team Collaboration</span>
                </div>
            </div>

            <div class="pt-4 border-t border-white/10 text-[11px] text-slate-400 flex items-center justify-between">
                <span>BSCS • USP Multan</span>
                <span class="text-purple-400 font-bold">Project Team Member</span>
            </div>
        </div>

    </div>

    <!-- Academic Deliverables & Presentation Launch Box -->
    <div class="w-full bg-gradient-to-r from-slate-900/90 via-slate-800/90 to-slate-900/90 backdrop-blur-3xl rounded-[32px] p-8 border border-white/10 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
            <span class="text-emerald-400 font-black text-[10px] tracking-widest uppercase mb-1 block">Academic Presentation Deliverables</span>
            <h4 class="text-xl font-black text-white">Interactive FYP Slides & Official PPTX</h4>
            <p class="text-slate-400 text-xs mt-1">13 slides covering problem, architecture, AI, database schema, and deployment metrics.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Home" asp-action="Presentation" class="px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-xs transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/20 transform hover:scale-105">
                <i class="fas fa-desktop"></i> View Live Presentation
            </a>
            <a asp-controller="Home" asp-action="DownloadPresentation" class="px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-all flex items-center gap-2 border border-white/10">
                <i class="fas fa-download text-amber-400"></i> Download (.pptx)
            </a>
        </div>
    </div>

</div>
