@model IEnumerable<ShareMeal.Web.Models.Donation>

@{
    ViewData["Title"] = "My Donations";
}

<div class="px-4 py-8 max-w-7xl mx-auto">
    <!-- Supply Overview Header -->
    <div class="bg-gradient-to-br from-amber-600/30 to-orange-900/30 border-l-[6px] border-l-amber-500 rounded-r-[2rem] p-8 mb-10 shadow-xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between">
        <div class="absolute -right-10 -top-10 opacity-10">
            <svg class="h-64 w-64 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
        </div>
        
        <div class="relative z-10 w-full mb-6 md:mb-0">
            <div class="inline-flex items-center gap-2 bg-amber-500/20 px-4 py-1.5 rounded-full mb-4 border border-amber-500/30">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                <span class="text-amber-400 font-bold text-[10px] uppercase tracking-widest">Active Supply Tracking</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">Your Food Posts</h1>
            <p class="text-amber-100/70 mt-2 text-lg">Monitor, manage, and track the status of your surplus food contributions.</p>
        </div>

        <div class="relative z-10 flex-shrink-0 flex flex-col gap-3 w-full md:w-auto">
            <a asp-controller="Donations" asp-action="Create" class="w-full text-center px-8 py-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-black rounded-xl shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all transform hover:-translate-y-1">
                + Post Fresh Meal
            </a>
            <a asp-controller="Restaurant" asp-action="Dashboard" class="w-full text-center px-8 py-3 bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 font-bold rounded-xl border border-slate-600 transition-all">
                Return to Portal
            </a>
        </div>
    </div>

    <!-- Inventory Logs -->
    <div class="bg-slate-900 border border-amber-900/30 rounded-[2rem] overflow-hidden shadow-2xl relative">
        <!-- Accent line -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>

        <div class="bg-slate-800/40 px-8 py-6 flex justify-between items-center border-b border-slate-700/50">
            <h3 class="text-white font-bold text-lg flex items-center gap-3">
                <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                Inventory Logs (@Model.Count())
            </h3>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left whitespace-nowrap">
                <thead>
                    <tr class="bg-slate-900 text-slate-500 text-[10px] uppercase tracking-[0.2em] font-black border-b border-slate-800">
                        <th class="px-8 py-6">Item Description</th>
                        <th class="px-8 py-6">Quantity</th>
                        <th class="px-8 py-6">Current Status</th>
                        <th class="px-8 py-6">Expiration</th>
                        <th class="px-8 py-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-800/30 transition-colors group">
                            <td class="px-8 py-5">
                                <div class="font-black text-white text-lg group-hover:text-amber-400 transition-colors">@item.FoodItem</div>
                                <div class="text-slate-500 text-xs mt-1">Ref ID: #@item.Id</div>
                            </td>
                            <td class="px-8 py-5">
                                <div class="inline-flex items-center justify-center bg-slate-800 text-slate-300 font-bold px-4 py-1.5 rounded-lg border border-slate-700 shadow-inner">
                                    @item.Quantity
                                </div>
                            </td>
                            <td class="px-8 py-5">
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-[11px] font-black uppercase tracking-wider
                                    @(item.Status == ShareMeal.Web.Models.DonationStatus.Available ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : 
                                      item.Status == ShareMeal.Web.Models.DonationStatus.Claimed ? "bg-amber-500/10 text-amber-400 border border-amber-500/20 shadow-[0_0_10px_rgba(251,191,36,0.2)]" : 
                                      "bg-blue-500/10 text-blue-400 border border-blue-500/20")">
                                    <span class="w-1.5 h-1.5 rounded-full 
                                        @(item.Status == ShareMeal.Web.Models.DonationStatus.Available ? "bg-emerald-400" : 
                                          item.Status == ShareMeal.Web.Models.DonationStatus.Claimed ? "bg-amber-400 animate-pulse" : 
                                          "bg-blue-400")"></span>
                                    @item.Status
                                </span>
                            </td>
                            <td class="px-8 py-5 text-slate-400 font-medium">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    @item.ExpiryDate.ToString("MMM dd, HH:mm")
                                </div>
                            </td>
                            <td class="px-8 py-5 text-right space-x-4">
                                <a asp-controller="Donations" asp-action="Details" asp-route-id="@item.Id" class="text-amber-400 hover:text-amber-300 font-bold text-[11px] uppercase tracking-wider transition-colors">Inspect</a>
                                @if(item.Status == ShareMeal.Web.Models.DonationStatus.Available)
                                {
                                    <button class="text-rose-500 hover:text-rose-400 font-bold text-[11px] uppercase tracking-wider transition-colors ml-2">Revoke</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center py-20 flex flex-col items-center">
                    <div class="bg-slate-800 p-5 rounded-full mb-5 shadow-inner">
                        <svg class="h-10 w-10 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
                    </div>
                    <h3 class="text-2xl font-black text-white mb-2">Inventory Empty</h3>
                    <p class="text-slate-400 max-w-sm mb-6">You haven't posted any food items yet. Start a donation to feed the community!</p>
                    <a asp-controller="Donations" asp-action="Create" class="px-6 py-3 bg-amber-500/10 text-amber-400 font-bold rounded-xl border border-amber-500/20 hover:bg-amber-500 hover:text-white transition-all shadow-sm">
                        Post Your First Meal
                    </a>
                </div>
            }
        </div>
    </div>
</div>
