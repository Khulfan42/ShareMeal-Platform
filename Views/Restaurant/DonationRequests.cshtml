@model IEnumerable<ShareMeal.Web.Models.Donation>

@{
    ViewData["Title"] = "Donation Requests";
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-10">
        <h1 class="text-3xl font-black text-white">Pending Requests</h1>
        <p class="text-slate-400 mt-2">Charities that have requested to claim your surplus food.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var item in Model)
        {
            <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-amber-500/30 overflow-hidden shadow-lg shadow-amber-900/10 transition-all hover:-translate-y-1">
                <div class="p-6">
                    <div class="flex justify-between items-start mb-4">
                        <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            Action Needed
                        </span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-100 mb-2">@item.FoodItem</h3>
                    <p class="text-slate-400 text-sm mb-4">Quantity: <span class="text-slate-200">@item.Quantity</span></p>

                    <div class="bg-slate-900/50 rounded-xl p-4 mb-6 border border-slate-700/50">
                        <p class="text-xs text-slate-500 uppercase font-bold tracking-wider mb-1">Requested By</p>
                        <p class="font-semibold text-emerald-400">@item.Recipient?.Name</p>
                        <p class="text-xs text-slate-400 mt-1">@item.Recipient?.ContactEmail</p>
                    </div>

                    <div class="flex items-center justify-between mt-auto">
                        <a asp-controller="Donations" asp-action="Details" asp-route-id="@item.Id" class="text-slate-400 hover:text-white text-sm font-semibold">View Details</a>
                        
                        <div class="flex space-x-2">
                            <!-- In a real app we'd have Accept/Reject logic -->
                            <button class="bg-slate-700 hover:bg-rose-500 hover:text-white text-slate-300 px-4 py-2 rounded-lg text-xs font-bold transition-colors">Reject</button>
                            <button class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg text-xs font-bold shadow-lg transition-colors">Accept Request</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20 bg-slate-800/30 rounded-3xl border-2 border-dashed border-slate-700">
            <p class="text-slate-400 text-lg">No pending requests right now.</p>
        </div>
    }
</div>
