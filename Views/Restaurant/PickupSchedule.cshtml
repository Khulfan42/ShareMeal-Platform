@model IEnumerable<ShareMeal.Web.Models.Donation>

@{
    ViewData["Title"] = "Pickup Schedule";
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-10">
        <h1 class="text-3xl font-black text-white">Pickup Schedule</h1>
        <p class="text-slate-400 mt-2">Manage timings for charities arriving to collect food.</p>
    </div>

    <div class="bg-slate-800/50 backdrop-blur-md rounded-3xl border border-slate-700/50 overflow-hidden shadow-2xl">
        <div class="p-8">
            <div class="relative border-l-2 border-slate-700 pl-8 space-y-12 py-4">
                @foreach (var item in Model)
                {
                    <div class="relative">
                        <!-- Timeline Node -->
                        <div class="absolute -left-[41px] top-1 h-5 w-5 rounded-full bg-blue-500 ring-4 ring-slate-900"></div>
                        
                        <div class="bg-slate-900/60 rounded-2xl p-6 border border-slate-700 hover:border-blue-500/30 transition-colors">
                            <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
                                <div>
                                    <h3 class="text-xl font-bold text-white">@item.FoodItem</h3>
                                    <p class="text-sm text-slate-400 mt-1">Collecting NGO: <span class="text-emerald-400 font-semibold">@item.Recipient?.Name</span></p>
                                </div>
                                <div class="mt-4 md:mt-0 text-left md:text-right">
                                    <p class="text-xs text-slate-500 uppercase font-black tracking-widest mb-1">Expected Pickup</p>
                                    <p class="text-lg font-bold text-blue-400">@item.ExpiryDate.ToString("MMM dd, h:mm tt")</p>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(item.PickupInstructions))
                            {
                                <div class="bg-slate-800 rounded-xl p-4 mt-4 text-sm text-slate-300">
                                    <span class="font-bold text-slate-400 mr-2">Your Instructions:</span> @item.PickupInstructions
                                </div>
                            }

                            <!-- Action Buttons -->
                            <div class="mt-6 flex flex-wrap gap-3">
                                <form asp-controller="Donations" asp-action="MarkAsCollected" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-xl font-bold shadow-lg shadow-emerald-900/20 transition-all flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                        Mark Completed
                                    </button>
                                </form>
                                
                                <form asp-controller="Donations" asp-action="CancelPickup" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="bg-slate-700 hover:bg-rose-500 text-slate-300 hover:text-white px-5 py-2.5 rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        Cancel Pickup
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-10">
                    <p class="text-slate-400 italic">No pickups scheduled.</p>
                </div>
            }
        </div>
    </div>
</div>
