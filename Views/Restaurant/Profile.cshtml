@model ShareMeal.Web.Models.Organization
@{
    ViewData["Title"] = "Organization Profile";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-10">
        <h1 class="text-3xl font-black text-white">Profile Settings</h1>
        <p class="text-slate-400 mt-2">Manage your organization details and security.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 p-4 rounded-xl mb-8 flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column: Links & Security -->
        <div class="space-y-6">
            <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-slate-700/50 p-6 shadow-2xl">
                <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-sm">Security</h3>
                <a href="/Identity/Account/Manage/ChangePassword" class="flex flex-col items-center justify-center p-6 bg-slate-900/60 rounded-xl hover:bg-slate-700 hover:border-emerald-500 border border-slate-700/50 transition-all font-semibold text-slate-300 hover:text-white gap-3 group">
                    <div class="bg-emerald-500/10 p-3 rounded-full text-emerald-500 group-hover:scale-110 transition-transform">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    </div>
                    Change Password
                </a>
            </div>

            <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-slate-700/50 p-6 shadow-2xl">
                <h3 class="text-white font-bold mb-2 uppercase tracking-widest text-sm">Organization Info</h3>
                <div class="space-y-3 mt-4">
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-black">Registered Email</p>
                        <p class="text-slate-300 font-medium">@Model.ContactEmail</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-black">Type</p>
                        <p class="text-blue-400 font-bold">@Model.Type</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-black">Status</p>
                        <span class="inline-block mt-1 px-3 py-1 rounded-full text-xs font-bold @(Model.Status == ShareMeal.Web.Models.OrganizationStatus.Verified ? "bg-emerald-500/20 text-emerald-400" : "bg-amber-500/20 text-amber-400")">
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Edit Details -->
        <div class="lg:col-span-2">
            <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl border border-slate-700/50 p-6 md:p-8 shadow-2xl">
                <h2 class="text-2xl font-black text-white mb-6">Update Details</h2>
                
                <form asp-action="Profile" method="post" class="space-y-6">
                    <input type="hidden" asp-for="Id" />
                    
                    <div>
                        <label asp-for="Name" class="block text-sm font-bold text-slate-400 mb-2 uppercase tracking-wider">Organization Name</label>
                        <input asp-for="Name" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" required />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="Phone" class="block text-sm font-bold text-slate-400 mb-2 uppercase tracking-wider">Phone / WhatsApp</label>
                            <input asp-for="Phone" placeholder="Enter contact number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" />
                        </div>
                    </div>

                    <div>
                        <label asp-for="Address" class="block text-sm font-bold text-slate-400 mb-2 uppercase tracking-wider">Full Address</label>
                        <input asp-for="Address" placeholder="Street, Sector, City" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" />
                    </div>

                    <div>
                        <label asp-for="Description" class="block text-sm font-bold text-slate-400 mb-2 uppercase tracking-wider">About Organization (Optional)</label>
                        <textarea asp-for="Description" rows="4" placeholder="Tell us a little about your mission or opening hours..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"></textarea>
                    </div>

                    <div class="pt-4 border-t border-slate-700/50">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-emerald-900/20 transition-all flex items-center justify-center gap-2 text-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>
