@{
    ViewData["Title"] = "Restaurant Dashboard";
}

<style>
    .resto-card {
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(243, 156, 18, 0.1);
        transition: all 0.3s ease;
    }
    .resto-card:hover {
        border-color: #f39c12;
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(243, 156, 18, 0.1);
    }
</style>

<div class="relative min-h-screen bg-slate-950 pt-32 pb-20 px-6">
    <!-- Background Texture -->
    <div class="absolute inset-0 z-0 opacity-20">
        <img src="~/restaurant_bg.png" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950/80 to-slate-950"></div>
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <!-- Hero Header -->
        <div class="mb-16">
            <span class="inline-flex items-center gap-2 bg-orange-500/10 text-orange-500 text-[10px] font-black uppercase tracking-[0.3em] px-4 py-1.5 rounded-full mb-6 border border-orange-500/20 shadow-[0_0_20px_rgba(243,156,18,0.1)]">
                👨‍🍳 Restaurant Partner Portal
            </span>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
                <div>
                    <h1 class="text-5xl md:text-7xl font-black text-white outfit leading-none tracking-tight">Post Your <br><span class="text-orange-500">Surplus.</span></h1>
                    <p class="text-slate-400 text-lg mt-6 max-w-xl font-medium leading-relaxed">
                        Instantly list surplus meals for local charities. Track your community impact and reduce daily waste in seconds.
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <a asp-controller="Donations" asp-action="Create" class="bg-orange-600 hover:bg-orange-500 text-white font-black py-4 px-8 rounded-2xl shadow-xl flex items-center gap-3">
                        <span>+ Post New Donation</span>
                        <span class="text-white/50">→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="resto-card p-10 rounded-[2.5rem]">
                <div class="flex items-center gap-4 mb-6">
                    <div class="bg-orange-500/20 p-3 rounded-2xl">
                        <svg class="w-7 h-7 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <p class="text-[11px] font-black text-slate-400 uppercase tracking-widest">Active Postings</p>
                </div>
                <p class="text-6xl font-black text-white outfit">@ViewBag.TotalDonations</p>
            </div>
            
            <div class="resto-card p-10 rounded-[2.5rem]">
                <div class="flex items-center gap-4 mb-6">
                    <div class="bg-emerald-500/20 p-3 rounded-2xl">
                        <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <p class="text-[11px] font-black text-slate-400 uppercase tracking-widest">Completed</p>
                </div>
                <p class="text-6xl font-black text-white outfit">@ViewBag.CompletedDonations</p>
            </div>

            <div class="resto-card p-10 rounded-[2.5rem]">
                <div class="flex items-center gap-4 mb-6">
                    <div class="bg-blue-500/20 p-3 rounded-2xl">
                        <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <p class="text-[11px] font-black text-slate-400 uppercase tracking-widest">Impact Score</p>
                </div>
                <p class="text-6xl font-black text-white outfit">A+</p>
            </div>
        </div>

        <!-- Dashboard Directory -->
        <h2 class="text-2xl font-black text-white outfit mb-8 uppercase tracking-widest">Inventory Management</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
            <a asp-action="MyDonations" class="resto-card p-8 rounded-3xl group">
                <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">🍔</div>
                <h3 class="text-lg font-black text-white mb-1">Stock History</h3>
                <p class="text-xs text-slate-500 font-medium tracking-tight">Audit past posts</p>
            </a>
            <a asp-action="DonationRequests" class="resto-card p-8 rounded-3xl group relative">
                @if (ViewBag.PendingRequests > 0)
                {
                    <span class="absolute top-4 right-4 bg-orange-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full">@ViewBag.PendingRequests</span>
                }
                <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">🔔</div>
                <h3 class="text-lg font-black text-white mb-1">Incoming</h3>
                <p class="text-xs text-slate-500 font-medium tracking-tight">NGO Requests</p>
            </a>
            <a asp-action="FoodTracking" class="resto-card p-8 rounded-3xl group">
                <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">🚚</div>
                <h3 class="text-lg font-black text-white mb-1">Logistics</h3>
                <p class="text-xs text-slate-500 font-medium tracking-tight">Real-time status</p>
            </a>
            <a asp-action="Profile" class="resto-card p-8 rounded-3xl group">
                <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">⚙️</div>
                <h3 class="text-lg font-black text-white mb-1">Settings</h3>
                <p class="text-xs text-slate-500 font-medium tracking-tight">Master Controls</p>
            </a>
        </div>
    </div>
</div>
